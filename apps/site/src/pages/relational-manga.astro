  .vnp-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .vnp-header h2 {
    font-family: var(--display);
    font-size: 1.05rem;
    margin: 0;
    color: var(--text);
  }
  .vnp-badge {
    font-family: var(--mono);
    font-size: 0.65rem;
