                0 0 14px color-mix(in srgb, var(--accent) calc(var(--field-density) * 50%), transparent);
    transform: scale(calc(1 + var(--field-density) * 0.025));
    transition: transform 0.25s var(--ease), border-color 0.25s, box-shadow 0.25s;
    outline: none;
  }
  .item-card-header {
    display: flex;
