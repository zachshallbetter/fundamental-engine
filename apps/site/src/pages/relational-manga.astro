---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StatusChip from '../components/StatusChip.astro';
import CodeTabs from '../components/CodeTabs.astro';
import { MANGA_WORKS, computeRelationalShelves, type ShelfResult, type MangaWork } from '../lib/manga-substrate-engine.ts';
import '../styles/docs.css';

const defaultRecent = ['work_evangelion', 'work_blame', 'work_akira', 'work_berserk'];
const initialShelves = computeRelationalShelves(defaultRecent);

const sampleCode = `import { MANGA_WORKS, computeRelationalShelves } from './manga-substrate-engine';

// 1. Define recent reading history anchors (real works/volumes)
const recentReading = ['work_evangelion', 'work_blame', 'work_akira', 'work_berserk'];

// 2. Vector Engine computes emergent shelves from 12D observation vectors
const shelves = computeRelationalShelves(recentReading);

// 3. Render emergent shelves with explicit "Why", "Held", and "Varied" explanations
shelves.forEach((shelf) => {
  console.log(\`=== \${shelf.title} ===\`);
  shelf.items.forEach((item) => {
    console.log(\` - \${item.work.title} (\${item.matchScore}% match)\`);
    console.log(\`   Why: \${item.explanation.why}\`);
    console.log(\`   Held: \${item.explanation.held.join(', ')}\`);
  });
});`;
---

<Base
  title="Relational Manga Substrate — Fundamental Engine"
  description="Empirical demonstration of relational manga recommendations derived from 12-dimensional observation vectors, edition hierarchies, page-range matches, and Fundamental Engine field bindings."
>
  <SiteNav current="examples" />

  <main id="main" class="manga-page-shell">
    <header class="manga-head">
      <p class="manga-kicker">Empirical Substrate Engine</p>
      <h1>Relational <span class="accent">Manga</span> Substrate</h1>
      <StatusChip label="Empirical Dataset · 25 Real Works & Edition Hierarchies" tone="demo" />
      <p class="manga-lede">
        Shelves shouldn't be hardcoded static categories. In this pipeline, 25 real manga works—from 
        <strong>BLAME!</strong> and <strong>AKIRA</strong> to <strong>Evangelion</strong>, <strong>Berserk</strong>, and 
        <strong>Goodnight Punpun</strong>—are analyzed across 12 measured visual &amp; structural dimensions 
        (<em>negative space, panel density, dialogue density, ink coverage, close-up frequency, environmental scale</em>). 
        Select a recent reading history to see emergent relational shelves generated dynamically by vector math.
      </p>
    </header>

    <!-- Recent Reading Selector Bar -->
    <section class="manga-preset-bar" aria-label="Reading History Anchors">
      <div class="preset-label">
        <span class="preset-title">User's Recent Reading History:</span>
        <span class="preset-sub">Select a preset to re-project the relational field:</span>
      </div>
      <div class="preset-buttons">
        <button type="button" class="preset-btn active" data-preset="cyberpunk-scale">
          Evangelion + BLAME! + AKIRA + Berserk
        </button>
        <button type="button" class="preset-btn" data-preset="quiet-contemplative">
          Evangelion Vol. 3 + Punpun + Girls' Last Tour + Vagabond
        </button>
        <button type="button" class="preset-btn" data-preset="kinetic-chaos">
          Chainsaw Man + Dorohedoro + AKIRA + Tekkonkinkreet
        </button>
      </div>
    </section>

    <!-- Vector Neighborhood Summary / Radar Cards -->
    <section class="vector-neighborhood-panel">
      <div class="vnp-header">
        <h2>Active Vector Neighborhood (12 Dimensions)</h2>
        <span class="vnp-badge">Computed Centroid</span>
      </div>
      <div class="vector-radar-grid" id="vector-radar">
        <div class="vector-dim"><span class="dim-name">Environmental Scale</span><span class="dim-bar" style="--val: 0.90;">90%</span></div>
        <div class="vector-dim"><span class="dim-name">Negative Space</span><span class="dim-bar" style="--val: 0.68;">68%</span></div>
        <div class="vector-dim"><span class="dim-name">Ink Coverage</span><span class="dim-bar" style="--val: 0.72;">72%</span></div>
        <div class="vector-dim"><span class="dim-name">Close-up Frequency</span><span class="dim-bar" style="--val: 0.58;">58%</span></div>
        <div class="vector-dim"><span class="dim-name">Dialogue Density</span><span class="dim-bar" style="--val: 0.35;">35%</span></div>
        <div class="vector-dim"><span class="dim-name">Visual Pacing</span><span class="dim-bar" style="--val: 0.45;">45%</span></div>
      </div>
    </section>

    <!-- Emergent Shelves Grid -->
    <div class="shelves-container" id="shelves-container">
      {initialShelves.map((shelf) => (
        <section class="shelf-section" id={`shelf-${shelf.id}`} data-body="well" data-strength="1.3" data-range="380">
          <header class="shelf-head">
            <div class="shelf-title-wrap">
              <h2>{shelf.title}</h2>
              <span class="shelf-subtitle">{shelf.subtitle}</span>
            </div>
            <span class="shelf-lens-tag">{shelf.lensType}</span>
          </header>

          <div class="shelf-items-row">
            {shelf.items.map((item) => (
              <article 
                id={`card-${shelf.id}-${item.work.id}`} 
                class="manga-item-card" 
                data-body="attract" 
                data-strength="0.7" 
                data-range="240" 
                data-feedback 
                data-work-id={item.work.id}
                tabindex="0"
              >
                <div class="item-card-header">
                  <span class="match-badge">{item.matchScore}% match</span>
                  <span class="format-badge">{item.work.editions[0]?.format || 'manga'}</span>
                </div>
                <h3>{item.work.title}</h3>
                <p class="item-author">{item.work.author} · {item.work.publisher}</p>

                {item.explanation.matchingPageRange && (
                  <div class="page-range-chip">
                    <span class="chip-label">Range:</span> {item.explanation.matchingPageRange}
                  </div>
                )}

                <div class="item-explanation">
                  <p class="why-text">{item.explanation.why}</p>
                  <div class="held-tags">
                    <span class="held-label">Held:</span>
                    {item.explanation.held.map((h) => (
                      <span class="tag-held">{h}</span>
                    ))}
                  </div>
                  {item.explanation.varied && (
                    <div class="varied-tags">
                      <span class="varied-label">Varied:</span>
                      {item.explanation.varied.map((v) => (
                        <span class="tag-varied">{v}</span>
                      ))}
                    </div>
                  )}
                </div>

                <footer class="item-card-footer">
                  <span class="edition-info">{item.work.editions.length} Edition(s)</span>
                  <span class="signal-readout">--field-density</span>
                </footer>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Code Section -->
    <section class="manga-code-section">
      <h2>Substrate Vector Engine Architecture</h2>
      <p>The vector calculation pipeline ingests measured observations and projects emergent clusters directly over Fundamental Engine.</p>
      <CodeTabs variants={[{ label: 'TypeScript Pipeline', lang: 'ts', code: sampleCode }]} />
    </section>

    <!-- Navigation Footer -->
    <nav class="manga-nav-footer">
      <a href="/examples">← Back to All Live Examples</a>
      <a href="/relational-publications">View Relational Publications Demo →</a>
      <a href="/docs/concepts">Read Substrate Architecture Docs →</a>
    </nav>
  </main>

  <SiteFooter />
</Base>

<script is:inline>
  // Interactive Recent Reading Presets Script
  const PRESETS = {
    'cyberpunk-scale': ['work_evangelion', 'work_blame', 'work_akira', 'work_berserk'],
    'quiet-contemplative': ['work_evangelion', 'work_goodnight_punpun', 'work_girls_last_tour', 'work_vagabond'],
    'kinetic-chaos': ['work_chainsaw_man', 'work_dorohedoro', 'work_akira', 'work_tekkonkinkreet']
  };

  const initMangaPage = () => {
    const presetBtns = document.querySelectorAll('[data-preset]');
    const getField = () => document.querySelector('field-root');

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const presetKey = btn.getAttribute('data-preset');
        presetBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        // Burst impulse on field
        const rect = btn.getBoundingClientRect();
        const f = getField();
        if (f && f.burst) f.burst(rect.left + rect.width / 2, rect.top, '#4da3ff');
      });
    });
  };

  if (document.readyState !== 'loading') initMangaPage();
  else document.addEventListener('DOMContentLoaded', initMangaPage);
  document.addEventListener('astro:page-load', initMangaPage);
</script>

<style>
  .manga-page-shell {
    max-width: var(--content-max, 1140px);
    margin: 0 auto;
    padding: calc(58px + 2.5rem) clamp(1.25rem, 4vw, 2rem) 6rem;
    position: relative;
    z-index: 2;
  }
  .manga-kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 75%, var(--text-3));
    margin: 0 0 0.5rem;
  }
  .manga-head h1 {
    font-family: var(--display);
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .manga-lede {
    max-width: 50rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-2);
    margin: 1rem 0 2rem;
  }
  .manga-lede strong {
    color: var(--text);
  }
  .manga-lede em {
    color: var(--accent);
    font-style: normal;
  }

  /* Preset Bar */
  .manga-preset-bar {
    padding: 1.25rem;
    border-radius: 14px;
    background: rgba(15, 23, 42, 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    margin-bottom: 2rem;
  }
  .preset-label {
    margin-bottom: 0.75rem;
  }
  .preset-title {
    font-family: var(--display);
    font-size: 0.95rem;
    color: var(--text);
    margin-right: 0.5rem;
  }
  .preset-sub {
    font-size: 0.85rem;
    color: var(--text-3);
  }
  .preset-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .preset-btn {
    font-family: var(--mono);
    font-size: 0.78rem;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-3);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .preset-btn:hover {
    color: var(--text);
    border-color: var(--accent);
    background: rgba(77, 163, 255, 0.1);
  }
