            <span class="chapter-cover" style="background: linear-gradient(135deg, #0f172a, #1e293b);"></span>
            <div class="chapter-content">
              <span class="chapter-locator">{ch.explanation.matchingPageRange}</span>
              <h3>{ch.work.title}</h3>
              <p class="chapter-mood">{ch.explanation.why}</p>
            </div>
