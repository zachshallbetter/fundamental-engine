---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StatusChip from '../components/StatusChip.astro';
import CodeTabs from '../components/CodeTabs.astro';
import { 
  MANGA_WORKS, 
  computeExclusiveRelationalShelves, 
  type ShelfResult, 
  type MangaWork,
  type ShelfItem
} from '../lib/manga-substrate-engine.ts';
import '../styles/docs.css';

const defaultRecent = ['work_evangelion', 'work_blame', 'work_akira', 'work_berserk'];
const { shelves: initialShelves, outsideItems: initialOutside, subChapters: initialChapters } = computeExclusiveRelationalShelves(defaultRecent);

const pipelineCode = `import { computeExclusiveRelationalShelves, resolveQueryChips } from './manga-substrate-engine';

// 1. Resolve query string into typed substrate chips
const chips = resolveQueryChips("quiet scenes with Liora · 1990s dark ink");

// 2. Compute exclusive emergent shelves (zero duplicate titles across rails)
const { shelves, subChapters, outsideItems } = computeExclusiveRelationalShelves(
  ['work_evangelion', 'work_blame', 'work_akira'],
  chips,
  { pace: true, space: true, color: false, closeup: false }
);

// 3. Render shelves with honest evidence confidence signals
shelves.forEach(shelf => {
  console.log(\`\${shelf.activeTitle} [\${shelf.evidenceState} · avg \${shelf.evidenceScore}%]\`);
});`;
---

<Base
  title="Relational Manga Substrate — Fundamental Engine"
  description="Exclusive emergent shelves, 39 real manga titles, chapter-level sub-publications, query-to-chip resolver, and Fundamental Engine field tethers."
>
  <SiteNav current="examples" />

  <main id="main" class="manga-substrate-shell" data-phase="in">
    <!-- Header & Resolved Query Bar -->
    <header class="manga-sub-head">
      <div class="head-top">
        <p class="sub-kicker">Relational Library Substrate</p>
        <h1>MangaVerse <span class="accent">— Library, Relationally</span></h1>
        <StatusChip label="39 Real Titles · Zero-Duplicate Exclusive Shelves" tone="demo" />
      </div>

      <!-- Natural Query Resolver Bar -->
      <div class="query-resolver-card">
        <div class="query-input-wrap">
          <span class="query-icon">/</span>
          <input 
            type="text" 
            id="query-input" 
            placeholder="quiet scenes with Liora · dark 1990s · unusual layouts · Otomo" 
            aria-label="Query library substrate"
          />
          <button type="button" id="btn-resolve" class="btn-resolve">resolve query</button>
        </div>

        <!-- Facets Bar -->
        <div class="facets-row">
          <button type="button" class="facet-btn active" data-facet="All">All (39)</button>
          <button type="button" class="facet-btn" data-facet="Series">Series</button>
          <button type="button" class="facet-btn" data-facet="1990s">1990s Era</button>
          <button type="button" class="facet-btn" data-facet="Cyberpunk">Cyberpunk</button>
          <button type="button" class="facet-btn" data-facet="Quiet">Quiet Pacing</button>
          <button type="button" class="facet-btn" data-facet="Omnibus">Omnibuses</button>
        </div>

        <!-- Resolved Chips Bar -->
        <div class="chips-resolved-bar" id="chips-bar">
          <span class="chips-label">Resolved query:</span>
          <div class="chips-list" id="chips-list">
            <span class="empty-chips">Type terms above or click a facet to resolve query chips</span>
          </div>
          <button type="button" id="btn-clear-query" class="btn-clear-query" style="display:none;">clear all</button>
        </div>
      </div>
    </header>

    <!-- Deterministic Input: Recently Read -->
    <section class="docs-sec" id="recently-read">
      <div class="sec-head-row">
        <div>
          <span class="sec-kicker">Deterministic · User Session Input</span>
          <h2>Recently read</h2>
          <p class="sec-desc">Four sessions form the input. Everything below is a projection of what they observed—pacing, panel scale, dialogue density, casts, places—not a genre lookup.</p>
        </div>
      </div>
      <div class="recent-grid">
        <article class="recent-card" data-body="attract" data-strength="1.1" data-feedback>
          <span class="recent-cover" style="background: linear-gradient(135deg, #1e1b4b, #312e81);"></span>
          <div class="recent-info">
            <h3>Neon Genesis Evangelion</h3>
            <span class="recent-meta">Vol. 12 · Stage 77-83</span>
            <div class="progress-bar-wrap"><span class="progress-fill" style="width: 63%;"></span></div>
            <div class="recent-footer"><span>63% read</span><span>2h ago</span></div>
          </div>
        </article>

        <article class="recent-card" data-body="attract" data-strength="1.1" data-feedback>
          <span class="recent-cover" style="background: linear-gradient(135deg, #022c22, #065f46);"></span>
          <div class="recent-info">
            <h3>BLAME!</h3>
            <span class="recent-meta">Vol. 1 · Log 2</span>
            <div class="progress-bar-wrap"><span class="progress-fill" style="width: 38%;"></span></div>
            <div class="recent-footer"><span>38% read</span><span>Yesterday</span></div>
          </div>
        </article>

        <article class="recent-card" data-body="attract" data-strength="1.1" data-feedback>
          <span class="recent-cover" style="background: linear-gradient(135deg, #451a03, #78350f);"></span>
          <div class="recent-info">
            <h3>AKIRA</h3>
            <span class="recent-meta">Vol. 1 · Ch. 1-4</span>
            <div class="progress-bar-wrap"><span class="progress-fill" style="width: 81%;"></span></div>
            <div class="recent-footer"><span>81% read</span><span>2 days ago</span></div>
          </div>
        </article>

        <article class="recent-card" data-body="attract" data-strength="1.1" data-feedback>
          <span class="recent-cover" style="background: linear-gradient(135deg, #311b92, #4a148c);"></span>
          <div class="recent-info">
            <h3>Berserk</h3>
            <span class="recent-meta">Vol. 13 · The Eclipse</span>
            <div class="progress-bar-wrap"><span class="progress-fill" style="width: 94%;"></span></div>
            <div class="recent-footer"><span>94% read</span><span>3 days ago</span></div>
          </div>
        </article>
      </div>
    </section>

    <!-- Sub-Publication Rail: Continue This Mood -->
    <section class="docs-sec" id="continue-mood">
      <div class="sec-head-row">
        <div>
          <span class="sec-kicker">Sub-publication · Specific Chapter Ranges</span>
