---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StatusChip from '../components/StatusChip.astro';
import CodeTabs from '../components/CodeTabs.astro';
import { 
  MANGA_WORKS, 
  computeExclusiveRelationalShelves, 
  generateMeasurementSvg,
  computeEditionDiff,
  type ShelfResult, 
  type MangaWork,
  type ShelfItem
} from '../lib/manga-substrate-engine.ts';
import '../styles/docs.css';

const defaultRecent = ['work_evangelion', 'work_blame', 'work_akira', 'work_berserk'];
const { shelves: initialShelves, outsideItems: initialOutside, subChapters: initialChapters } = computeExclusiveRelationalShelves(defaultRecent);

const akiraWork = MANGA_WORKS.find(w => w.id === 'work_akira') || MANGA_WORKS[0];
const akiraDiff = computeEditionDiff(akiraWork);

const crossFormatCode = `// Cross-format alignment (Manga ⇄ Prose Novel ⇄ Screenplay)
const dune = MANGA_WORKS.find(w => w.id === 'work_dune'); // Prose Novel
const script = MANGA_WORKS.find(w => w.id === 'work_2001_script'); // Screenplay

// All format observations normalized to z-scores against corpus baseline
const zDune = getWorkZScore(dune);
const zScript = getWorkZScore(script);

console.log(\`Dune Arrakis Chapters z-env: \${zDune.environmentalScale.toFixed(2)}\`);
console.log(\`2001 Star Gate Script z-dialogue: \${zScript.dialogueDensity.toFixed(2)}\`);`;

const dnaCode = `import { exportSubstrateDna } from './manga-substrate-engine';

// Export canonical Substrate DNA fingerprint
const dna = exportSubstrateDna(work.rawVector);
console.log(dna);
/*
{
  "substrateDna": "4.0",
  "zScores": {
    "environmentalScale": "+1.98",
    "dialogueDensity": "-2.10",
    "inkCoverage": "+0.85"
  },
  "provenance": "fundamental-engine/substrate-v4"
}
*/`;
---

<Base
  title="Relational Substrate Engine — Cross-Format Media & Revision Diffs"
  description="Cross-format media alignment (manga, prose novels, screenplays), edition diff visualizers, live local pinch-zoom signal harness, and Substrate DNA fingerprints."
>
  <SiteNav current="examples" />

  <main id="main" class="manga-substrate-shell" data-phase="in">
    <!-- Header & Resolved Query Bar -->
    <header class="manga-sub-head">
      <div class="head-top">
        <p class="sub-kicker">Relational Library Substrate · Universal Media Engine</p>
        <h1>MangaVerse <span class="accent">— Substrate, Cross-Format</span></h1>
        <StatusChip label="39 Works · Manga ⇄ Prose ⇄ Screenplay · Revision Diffs" tone="demo" />
      </div>

      <!-- Privacy & Expectation Banner -->
      <div class="privacy-expectation-banner">
        <div class="banner-col">
          <span class="b-label">Cross-Format Alignment:</span>
          <p>Maps visual density, environmental scale, and dialogue pacing across Manga, Prose Novels (<em>Dune</em>), and Screenplays (<em>2001</em>).</p>
        </div>
        <div class="banner-col">
          <span class="b-label">Falsifiable Edition Diffs:</span>
          <p>Empirically visualizes vector splits between revisions (e.g. <em>AKIRA 35th Boxset</em> vs <em>1988 Colorized Edition</em>).</p>
        </div>
      </div>

      <!-- Revision Split Visualizer Card -->
      <div class="revision-diff-card">
        <div class="diff-head">
          <span class="diff-kicker">Falsifiable Revision Split</span>
          <h3>{akiraWork.title} — Edition Delta ({akiraDiff.editionA} vs {akiraDiff.editionB})</h3>
          <p>{akiraDiff.revisionNote}</p>
        </div>
        <div class="diff-metrics-grid">
          <div class="diff-metric-box">
            <span class="d-label">SFX Vector Delta (&Delta; z_sfx)</span>
            <span class="d-val">{akiraDiff.zDelta.sfxDensity.toFixed(2)} &sigma;</span>
            <span class="d-sub">Hand-drawn Japanese SFX restored vs typeset</span>
          </div>
          <div class="diff-metric-box">
            <span class="d-label">Ink &amp; Palette Delta (&Delta; z_ink)</span>
            <span class="d-val">{akiraDiff.zDelta.inkCoverage.toFixed(2)} &sigma;</span>
            <span class="d-sub">B&amp;W high-contrast vs Epic Comics colorized</span>
          </div>
        </div>
      </div>

      <!-- Natural Query Resolver Bar -->
      <div class="query-resolver-card">
        <div class="query-input-wrap">
          <span class="query-icon">/</span>
          <input 
            type="text" 
            id="query-input" 
            placeholder="quiet scenes with Liora · dark 1990s · Dune Arrakis · Otomo" 
            aria-label="Query library substrate"
          />
          <button type="button" id="btn-resolve" class="btn-resolve">resolve query</button>
        </div>

        <!-- Facets Bar -->
        <div class="facets-row">
          <button type="button" class="facet-btn active" data-facet="All">All (39)</button>
          <button type="button" class="facet-btn" data-facet="Series">Series</button>
          <button type="button" class="facet-btn" data-facet="1990s">1990s Era</button>
          <button type="button" class="facet-btn" data-facet="Cyberpunk">Cyberpunk</button>
          <button type="button" class="facet-btn" data-facet="Quiet">Quiet Pacing</button>
          <button type="button" id="btn-empty-toggle" class="facet-btn btn-empty-demo">Test Empty Case (Low Evidence)</button>
        </div>

        <!-- Resolved Chips Bar -->
        <div class="chips-resolved-bar" id="chips-bar">
          <span class="chips-label">Resolved query:</span>
          <div class="chips-list" id="chips-list">
            <span class="empty-chips">Type terms above or click a facet to resolve query chips</span>
          </div>
          <button type="button" id="btn-clear-query" class="btn-clear-query" style="display:none;">clear all</button>
        </div>
      </div>
    </header>

    <!-- Deterministic Input: Recently Read -->
    <section class="docs-sec" id="recently-read">
      <div class="sec-head-row">
        <div>
          <span class="sec-kicker">Deterministic · User Session Input</span>
          <h2>Recently read (Cross-Format Media Signatures)</h2>
          <p class="sec-desc">Media format tags indicate whether a work is Manga, a Prose Novel, or a Film Screenplay. All normalized to unified z-scores.</p>
        </div>
      </div>
      <div class="recent-grid">
        {MANGA_WORKS.filter(w => defaultRecent.includes(w.id)).map(work => (
          <article class="recent-card" data-body="attract" data-strength="1.1" data-feedback>
            <div class="measurement-cover-wrap" set:html={generateMeasurementSvg(work.rawVector, 260, 110)} />
            <div class="recent-info">
              <div class="format-badge-row">
                <span class="recent-format-tag">{work.mediaFormat || 'manga'}</span>
                <span class="revision-tag">{work.measuredRevision || 'Canonical Edition'}</span>
              </div>
              <h3>{work.title}</h3>
              <span class="recent-meta">{work.author} · {work.yr}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Sub-Publication Rail: Continue This Mood -->
    <section class="docs-sec" id="continue-mood">
      <div class="sec-head-row">
        <div>
          <span class="sec-kicker">Sub-publication · Normalized Edition Locators</span>
          <h2>Continue this mood</h2>
          <p class="sec-desc">Canonical locators translated to edition-specific page ranges across formats.</p>
        </div>
      </div>
      <div class="chapters-grid" id="chapters-rail">
        {initialChapters.map((ch) => (
          <article class="chapter-card" data-body="attract" data-strength="0.8" data-feedback tabindex="0">
            <div class="measurement-cover-wrap" set:html={generateMeasurementSvg(ch.work.rawVector, 220, 80)} />
            <div class="chapter-content">
              <span class="chapter-locator">{ch.explanation.matchingPageRange}</span>
              <h3>{ch.work.title}</h3>
              <p class="chapter-mood">{ch.explanation.why}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Section Separator -->
    <div class="substrate-divider">
      <span class="divider-line"></span>
      <span class="divider-label">Exclusive Emergent Shelves (Cross-Format Manga ⇄ Novel ⇄ Script)</span>
      <span class="divider-line"></span>
    </div>

    <!-- Exclusive Emergent Shelves Rails -->
    <div class="exclusive-shelves-list" id="shelves-rail">
      {initialShelves.map((shelf) => (
        <section 
          id={`shelf-${shelf.id}`} 
          class="shelf-rail-card" 
          data-body="well" 
          data-strength="1.3" 
          data-range="400"
          data-evidence={shelf.evidenceState}
        >
          <header class="shelf-rail-head">
            <div class="shelf-head-title">
              <div class="shelf-badge-row">
                <span class={`evidence-chip state-${shelf.evidenceState}`}>
                  {shelf.evidenceState === 'new' ? 'new this week' : shelf.evidenceState === 'steady' ? 'steady' : 'fading evidence'} · {shelf.evidenceScore}% z-score
                </span>
                <span class="surprise-accept-tag">Surprise-Accept Optimized</span>
              </div>
              <h2 class="active-title">{shelf.activeTitle}</h2>
              <p class="permanent-machine-sub"><span class="sub-lead">Substrate signal:</span> {shelf.generatedLabel.toUpperCase()}</p>
              <p class="shelf-sub">{shelf.subtitle}</p>
            </div>

            {shelf.counterfactual && (
              <div class="counterfactual-controls">
                <span class="cf-label">Hold:</span>
                <button type="button" class="cf-btn active" data-hold="pace">slow pacing</button>
                <button type="button" class="cf-btn active" data-hold="space">wide panels</button>
                <button type="button" class="cf-btn" data-hold="color">colour</button>
                <button type="button" class="cf-btn" data-hold="closeup">close-ups</button>
              </div>
            )}
          </header>

          <div class="shelf-cards-scroll">
            {shelf.items.map((item) => (
              <article 
                id={`card-${shelf.id}-${item.work.id}`} 
                class="manga-exclusive-card" 
                data-body="attract" 
                data-strength="0.75" 
                data-range="240" 
                data-feedback 
                data-work-id={item.work.id}
                tabindex="0"
              >
                <!-- Measurement Visual Cover Signature -->
                <div class="measurement-cover-wrap card-cover-measurement" set:html={generateMeasurementSvg(item.work.rawVector, 200, 95)}>
                  <span class="match-score-badge">{item.matchScore}% match</span>
                </div>

                <div class="card-body">
                  <div class="card-title-row">
                    <h3>{item.work.title}</h3>
                    <span class="media-format-badge">{item.work.mediaFormat || 'manga'}</span>
                  </div>
                  <span class="card-meta">{item.work.author} · {item.work.yr || 2020}</span>
                  <p class="card-why">{item.explanation.why}</p>
                  
                  <div class="card-held-tags">
                    {item.explanation.held.map((h) => (
                      <span class="tag-h">{h}</span>
                    ))}
                    {item.surpriseAcceptScore && (
                      <span class="tag-surprise">surprise: +{item.surpriseAcceptScore}%</span>
                    )}
                  </div>

                  <div class="card-provenance-line">
                    <span>{item.explanation.provenance}</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Outside Your Usual Section -->
    <section id="outside-usual" class="outside-usual-sec" data-body="repel" data-strength="0.8" data-range="300">
      <div class="outside-inner">
        <div class="outside-text">
          <span class="outside-kicker">Surprise-Accept Optimized · Anti-Filter Bubble</span>
          <h2>Outside your usual</h2>
          <p>Works sharing zero genre or author overlap while maintaining vector pacing alignment. Rewards surprise acceptance and penalizes recommendations in a loop.</p>
        </div>
        <div class="outside-cards-grid">
          {initialOutside.map((item) => (
            <article class="outside-card" data-body="attract" data-strength="0.6" data-feedback>
              <div class="measurement-cover-wrap" set:html={generateMeasurementSvg(item.work.rawVector, 200, 85)} />
              <div class="outside-info">
                <h3>{item.work.title}</h3>
                <span class="outside-meta">{item.work.author} · {item.work.publisher}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Code Architecture Section -->
    <section class="manga-code-section">
      <h2>Cross-Format &amp; Substrate DNA Fingerprint Architecture</h2>
      <p>Universal media format alignment and exported Substrate DNA fingerprints.</p>
      <CodeTabs variants={[
        { label: 'Cross-Format Media', lang: 'ts', code: crossFormatCode },
        { label: 'Substrate DNA Fingerprint', lang: 'json', code: dnaCode }
      ]} />
    </section>

    <!-- Navigation Footer -->
    <nav class="manga-nav-footer">
      <a href="/examples">← Back to All Live Examples</a>
      <a href="/relational-publications">View Relational Publications Demo →</a>
      <a href="/docs/concepts">Read Substrate Architecture Docs →</a>
    </nav>
  </main>

  <SiteFooter />
</Base>

<script is:inline>
  const initSubstratePage = () => {
    const input = document.getElementById('query-input');
    const resolveBtn = document.getElementById('btn-resolve');
    const clearBtn = document.getElementById('btn-clear-query');
    const chipsBar = document.getElementById('chips-list');
    const facetBtns = document.querySelectorAll('[data-facet]');
    const emptyToggle = document.getElementById('btn-empty-toggle');
    const shelvesRail = document.getElementById('shelves-rail');
    const shell = document.querySelector('.manga-substrate-shell');

    let isEmptyMode = false;

    const triggerTransition = () => {
      if (shell) {
        shell.setAttribute('data-phase', 'out');
        setTimeout(() => {
          shell.setAttribute('data-phase', 'in');
        }, 180);
      }
    };

    facetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        facetBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        triggerTransition();
      });
    });

    emptyToggle?.addEventListener('click', () => {
      isEmptyMode = !isEmptyMode;
      if (emptyToggle) emptyToggle.classList.toggle('active', isEmptyMode);
      if (shelvesRail) {
        if (isEmptyMode) {
          shelvesRail.innerHTML = `
            <div class="empty-shelf-notice">
              <span class="empty-icon">⚠</span>
              <h2>No Emergent Shelf Earned Its Place Today</h2>
              <p>Substrate evidence scores fell below confidence threshold (z &lt; +0.50). Showing plain collection without forced poetic titles.</p>
            </div>
          `;
        } else {
          window.location.reload();
        }
      }
      triggerTransition();
    });

    resolveBtn?.addEventListener('click', () => {
      const q = input?.value;
      if (chipsBar && q) {
        chipsBar.innerHTML = `<span class="resolved-chip">query: "${q}"</span>`;
        if (clearBtn) clearBtn.style.display = 'inline-block';
      }
      triggerTransition();
    });

    clearBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      if (chipsBar) chipsBar.innerHTML = `<span class="empty-chips">Type terms above or click a facet to resolve query chips</span>`;
      if (clearBtn) clearBtn.style.display = 'none';
      triggerTransition();
    });
  };

  if (document.readyState !== 'loading') initSubstratePage();
  else document.addEventListener('DOMContentLoaded', initSubstratePage);
  document.addEventListener('astro:page-load', initSubstratePage);
</script>

<style>
  .manga-substrate-shell {
    max-width: var(--content-max, 1180px);
    margin: 0 auto;
    padding: calc(58px + 2.5rem) clamp(1.25rem, 4vw, 2rem) 6rem;
    position: relative;
    z-index: 2;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .manga-substrate-shell[data-phase="out"] {
    opacity: 0.25;
    transform: scale(0.995);
  }
  .manga-substrate-shell[data-phase="in"] {
    opacity: 1;
    transform: scale(1);
  }

  .sub-kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 75%, var(--text-3));
    margin: 0 0 0.5rem;
  }
  .manga-sub-head h1 {
    font-family: var(--display);
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  /* Privacy & Expectation Banner */
  .privacy-expectation-banner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid rgba(16, 185, 129, 0.25);
    margin: 1.25rem 0;
  }
  @media (max-width: 768px) { .privacy-expectation-banner { grid-template-columns: 1fr; } }
  .b-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: #10b981;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .privacy-expectation-banner p {
    font-size: 0.82rem;
    color: var(--text-2);
    margin: 0.2rem 0 0;
  }

  /* Revision Diff Card */
  .revision-diff-card {
    padding: 1.25rem;
    border-radius: 14px;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(56, 201, 234, 0.3);
    margin: 1.25rem 0 2rem;
  }
  .diff-head {
    margin-bottom: 0.85rem;
  }
  .diff-kicker {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    color: var(--accent);
  }
  .diff-head h3 {
    font-family: var(--display);
    font-size: 1.15rem;
    margin: 0.2rem 0 0.2rem;
  }
  .diff-head p {
    font-size: 0.82rem;
    color: var(--text-3);
    margin: 0;
  }
  .diff-metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 640px) { .diff-metrics-grid { grid-template-columns: 1fr; } }
  .diff-metric-box {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: rgba(2, 6, 23, 0.6);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .d-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--text-4);
  }
  .d-val {
    font-family: var(--mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: #10b981;
  }
  .d-sub {
    font-size: 0.75rem;
    color: var(--text-3);
  }

  /* Query Resolver Card */
  .query-resolver-card {
    padding: 1.25rem;
    border-radius: 16px;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    margin: 1.5rem 0 2.5rem;
  }
  .query-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: rgba(2, 6, 23, 0.8);
    border: 1px solid var(--line);
    margin-bottom: 1rem;
  }
  .query-icon {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--text-4);
  }
  .query-input-wrap input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text);
    font-family: var(--sans);
    font-size: 0.9rem;
  }
  .btn-resolve {
    font-family: var(--mono);
    font-size: 0.75rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: none;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
  }

  /* Facets Row */
  .facets-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .facet-btn {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-3);
    cursor: pointer;
  }
  .facet-btn:hover, .facet-btn.active {
    color: #fff;
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .btn-empty-demo {
    border-color: #f59e0b;
    color: #f59e0b;
  }

  /* Chips Resolved Bar */
  .chips-resolved-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .chips-label {
    color: var(--text-4);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.65rem;
  }
  .chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1;
  }
  .empty-chips {
    color: var(--text-4);
    font-style: italic;
  }
  .resolved-chip {
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
  }
  .btn-clear-query {
    font-family: var(--mono);
    font-size: 0.7rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
  }

  /* Section Styles */
  .sec-head-row {
    margin-bottom: 1.25rem;
  }
  .sec-kicker {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-4);
  }
  .sec-head-row h2 {
    font-family: var(--display);
    font-size: 1.4rem;
    margin: 0.2rem 0 0.4rem;
  }
  .sec-desc {
    font-size: 0.88rem;
    color: var(--text-3);
    margin: 0;
  }

  /* Measurement Cover Wrap */
  .measurement-cover-wrap {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
  }
  .measurement-cover-wrap svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Format Badges */
  .format-badge-row {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: 0.2rem;
  }
  .recent-format-tag, .media-format-badge {
    font-family: var(--mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    color: #a855f7;
    background: rgba(168, 85, 247, 0.12);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    border: 1px solid rgba(168, 85, 247, 0.25);
  }

  /* Recent Grid */
  .recent-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 860px) { .recent-grid { grid-template-columns: repeat(2, 1fr); } }
