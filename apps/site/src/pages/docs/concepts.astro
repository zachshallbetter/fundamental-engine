---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeTabs from '../../components/CodeTabs.astro';
import ForceCell from '../../components/ForceCell.astro';
import FieldLoopDemo from '../../components/FieldLoopDemo.astro';
import ApiStamp from '../../components/ApiStamp.astro';
import SeeItLive from '../../components/SeeItLive.astro';
import StatusChip from '../../components/StatusChip.astro';
import VocabBadge from '../../components/VocabBadge.astro';
import VocabLegend from '../../components/VocabLegend.astro';
import { MANUAL_FORCES, NATURAL_FIELDS, FORCE_KIND, FORCE_FIELD } from '@fundamental-engine/core';

// ── docs-refactor Phase 6 (#1001): ONE concepts narrative ─────────────────────────────────────────
// This page absorbed /docs/concepts#natural-fields (the four-field translation model) and /docs/concepts#walkthrough (the
// layer-by-layer walkthrough); both redirect here, to #natural-fields and #walkthrough. The plan
// (§6.2) asks for concepts as one connected narrative rather than a page-per-idea pile, and these
// three were the pile: the model, the translation table, and the walkthrough were each half of an
// argument the reader had to assemble from three URLs.

// The data-attribute pattern per natural field — honest runtime tokens only. A token's field is its
// classification, not a separate API.
//
// Phase 6 status sweep: these samples used to carry `data-field-role="priority"` and
// `data-field-role="revising"`. Neither is a field role — FIELD_ROLES (core/visual/tokens.ts) is
// source · sink · anchor · boundary · sensor · display, and the scanner ignores anything else, so the
// attribute was silently inert in published sample code.
const patGravity = `<!-- Gravity → priority: the element converges attention -->
<section data-body="gravity" data-field-role="source" data-strength="0.9">
  <h2>What matters most</h2>
</section>`;
const patEm = `<!-- Electromagnetic → polarity / signal. Electric pushes, magnetic bends. -->
<button data-body="charge" data-spin="1" data-range="280">positive</button>
<button data-body="charge" data-spin="-1" data-range="280">negative</button>
<!-- magnetism bends matter along the field; fieldflow carries it along the lines -->`;
const patStrong = `<!-- Strong → binding. A native link IS the relationship — no new API. -->
<p id="claim">The runtime is renderer-agnostic.</p>
<a href="#claim" data-field-relation="supports" data-field-target="#claim">
  Evidence: the boundary test
</a>`;
const patWeak = `<!-- Weak → transformation / decay. Not a fake force — state that ages. -->
<article data-body="morph">
  <!-- or: a memory metric that decays, or a pattern that releases over time -->
</article>`;

const FIELD_COLOR: Record<string, string> = {
  gravity: '#4da3ff', electromagnetic: '#2dd4bf', strong: '#a78bfa', weak: '#ff9d5c',
};
const KIND_LABEL: Record<string, string> = {
  designed: 'Designed UI verb', primitive: 'Field primitive', derived: 'Derived behavior',
  analogue: 'Material analogue', transport: 'Transport', metric: 'Metric',
};
const KIND_ORDER = ['primitive', 'analogue', 'transport', 'derived', 'metric', 'designed'] as const;
// group every catalog token by its translation kind (from the engine's classification)
const byKind = KIND_ORDER.map((kind) => ({
  kind,
  label: KIND_LABEL[kind],
  tokens: MANUAL_FORCES.filter((f) => FORCE_KIND[f.token] === kind).map((f) => ({ token: f.token, field: FORCE_FIELD[f.token] })),
})).filter((g) => g.tokens.length);

// Each row separates the lanes: runtime tokens (strict), metrics (measured state), diagnostics
// (inspection modes). They are deliberately NOT merged into one "primitives" column.
const TRANSLATION: [string, string, string, string, string][] = [
  ['Show importance', 'Gravity', 'gravity, attract', 'mass, priority, attention', 'potential, prediction'],
  ['Route signal', 'Electromagnetic', 'charge, propagate, fieldflow, stream', 'signal, strength', 'field-lines, force-vectors'],
  ['Show relationship', 'Strong + EM', 'link, cohesion', 'relation-strength', 'topology, causality'],
  ['Keep things grouped', 'Strong', 'cohesion, crystallize, align', 'cluster, density', 'topology, heatmap'],
  ['Show change / decay', 'Weak', 'morph, memory', 'decay, age', 'causality, contours'],
  ['Show flow through structure', 'EM + transport', 'fieldflow, stream', 'flow, velocity', 'field-lines, prediction'],
  ['Show reading history', 'Memory (metric)', 'memory', 'attention, recency', 'heatmap, inspector'],
];
const DIAG = [
  ['Potential', 'wells and energy landscape', 'Gravity'],
  ['Field lines', 'electromagnetic structure', 'Electromagnetic'],
  ['Topology', 'binding and relationships', 'Strong'],
  ['Causality', 'which primitive caused change', 'any'],
  ['Prediction', 'near-future path', 'Gravity / flow'],
  ['Contours', 'scalar fields', 'derived'],
];

// ── the walkthrough (merged from /docs/concepts#walkthrough) ────────────────────────────────────────────────
// One ordinary element, revealed as a field participant one layer at a time: semantic DOM → data
// attributes → registered body → runtime token → metric → feedback → relationships → diagnostics →
// reduced motion. At the feedback stage it is driven deterministically by applyPattern (no canvas, no
// cursor needed), so the number the reader sees is one the field actually wrote.
const stages = [
  {
    title: 'Semantic DOM',
    body: 'Start with real, accessible HTML — a heading and a note. No field yet, nothing to undo. Whatever happens next, this stays selectable, focusable, and readable.',
    markup: '<article>\n  <h3>Reciprocal interfaces</h3>\n</article>',
  },
  {
    title: 'Data attributes',
    body: 'Mark the element a body with one attribute. This is the entire authoring contract — there is no special element, you add attributes to the HTML you already have.',
    markup: '<article\n  data-body="attract"\n  data-strength="0.8"\n  data-range="280"\n>\n  <h3>Reciprocal interfaces</h3>\n</article>',
  },
  {
    title: 'A registered body',
    body: 'The platform scanner discovers every [data-body] element each frame and registers its box for measurement. The element is now a body in the one shared field — no JS wiring required.',
    markup: '// platform scanner (per frame)\nBODY_SELECTOR // [data-body], [data-preset],\n              // [data-intent], [data-field-role]\n→ MeasurementRegistry.register(el)',
  },
  {
    title: 'A runtime token',
    body: 'The value of data-body is a runtime token — attract — and only real tokens execute. A concept (priority, polarity) describes; it never runs. attract pulls matter toward the element each frame.',
    markup: 'data-body="attract"\n// attract: a designed force token\n// (a concept like "priority" is NOT a token —\n//  it is translated to one)',
  },
  {
    title: 'Metrics',
    body: 'From the body and its neighbours the field computes metrics — attention, priority, coherence, entropy. Metrics are measured numbers, not forces. A pattern declares which metrics a field tracks.',
    markup: '// computeMetrics(body, neighbours, relationships)\n→ { attention: 0.7, priority: 0.85, … }\n// a metric measures; it does not push',
  },
  {
    title: 'Feedback',
    body: 'Add data-feedback and the field writes a metric back as a --field-* custom property on the element. CSS reads it — the heading gains weight. The value below is written by applyPattern, deterministically.',
    markup: 'data-feedback\n// → element.style[\'--field-priority\'] = 0.85\n.h3 { font-weight: calc(400 + var(--field-priority) * 320) }',
    feedback: true,
  },
  {
    title: 'Relationships',
    body: 'A native link — an href, aria-controls, or data-field-relation/-target — becomes an edge in the relationship graph. The graph is discovered from the DOM, never declared in JS.',
    markup: '<a href="#claim"\n   data-field-relation="supports"\n   data-field-target="#claim">evidence</a>\n// RelationshipRegistry → one typed graph',
    rel: true,
  },
  {
    title: 'Diagnostics',
    body: 'A diagnostic reveals the invisible structure — potential, topology, causality. It inspects behaviour; it never causes it. Open the Inspector to read the live registries each frame.',
    markup: '// diagnostics EXPLAIN, they do not execute\npotential · topology · causality · prediction\n→ /docs/inspector (read-only)',
    link: '/docs/inspector',
  },
  {
    title: 'Reduced motion',
    body: 'Under prefers-reduced-motion the field freezes and the element holds a static, emphasised baseline. The point the motion made — which element carries weight — survives with the motion off.',
    markup: '@media (prefers-reduced-motion: reduce) {\n  /* hold the last value, no travel */\n  .h3 { font-weight: 560; transition: none }\n}',
    reduced: true,
  },
];

const bodySnippet = `<a
  data-body="attract swirl"  // forces compose, space-separated
  data-strength="0.9"
  data-range="320"
  data-color="#4da3ff"
  data-when="active"         // gate: only acts while engaged
  data-feedback              // opt into density write-back
>link</a>`;

const pipeSnippet = `// read phase — DOM → field (platform MeasurementRegistry, once per frame, per body)
cx = (rect.left + rect.width / 2) * DPR
cy = (rect.top  + rect.height / 2) * DPR

// write phase — field → DOM (platform FeedbackRegistry, per data-feedback body)
element.style.setProperty('--d', density)   // d ∈ [0, 1], canonical raw channel
// (the field-namespaced --field-density is written too, same value)`;

const feedbackSnippet = `.headline {
  /* the field writes the density channel; CSS turns density into weight + glow.
     --d is the canonical raw channel; --field-density is its field-namespaced form. */
  font-variation-settings: 'wght' calc(380 + var(--field-density, 0) * 420);
  text-shadow: 0 0 calc(var(--field-density, 0) * 40px) rgba(77, 163, 255, var(--field-density, 0));
}`;

// The cell-supported primitives (the poster engine implements these seven).
const byTok = Object.fromEntries(MANUAL_FORCES.map((f) => [f.token, f]));
const DEMOS = [
  { token: 'attract', caption: 'pulls matter into a central well' },
  { token: 'repel', caption: 'carves a clean void at the centre' },
  { token: 'swirl', caption: 'circles matter without pulling in' },
  { token: 'gravity', caption: 'a true 1/d² well, softened at the core' },
  { token: 'stream', caption: 'a constant current along one heading' },
  { token: 'buoyancy', caption: 'a steady lift against the frame' },
  { token: 'tether', caption: 'holds matter at a fixed radius' },
];
---

<DocsLayout
  title="Fundamental — Concepts"
  description="The mental model behind Fundamental: elements become bodies in one shared field, the runtime measures them, and importance and relationships write back as live state."
>
  <header class="docs-hero">
    <p class="kicker">Concepts</p>
    <h1>How the field <span class="accent">thinks</span>.</h1>
    <StatusChip label="Shipped · every claim here runs on this page" tone="stable" />
    <p class="lede">
      Fundamental is a platform-native relational field runtime; the DOM is its first host. Elements
      are bodies in one <strong>shared field context</strong> — they bend the field; its density bends
      them back. A renderer-agnostic core computes the field; a host adapter binds it to a platform
      (on the web, to the DOM). The visible canvas is one render surface, not the whole system.
    </p>
  </header>

  <section class="docs-sec">
    <h2>Bodies</h2>
    <p>
      A <strong>body</strong> is any element you mark with <code>data-body</code>. Its value is
      one or more <em>force</em> tokens, space-separated — they compose, so a single element
      can attract and swirl at once. The engine re-reads each body's bounding box every frame,
      so moving the element moves the force.
    </p>
    <CodeTabs variants={[{ label: 'HTML', lang: 'html', code: bodySnippet }]} />
    <p>
      Common attributes — <code>data-strength</code>, <code>data-range</code>,
      <code>data-color</code>, <code>data-spin</code>, <code>data-angle</code> — are read by the
      forces that use them; each force ignores the ones it doesn't. See the
      <a href="/docs/api/declarative#body-contract">attribute reference</a> for the full matrix.
    </p>
    <div class="callout">
      <b>Data attributes are the contract.</b> You make semantic HTML participate in the field by adding
      attributes to it — there is no special body element. <code>&lt;field-root&gt;</code> only hosts the
      field; <code>applyPattern()</code> <ApiStamp name="applyPattern" /> and <code>bindData()</code>
      <ApiStamp name="bindData" /> adapt it to patterns and data; and the
      <code>&lt;field-cell&gt;</code> frames lower down are just isolated single-force microscopes. The
      system is the markup, not the components.
    </div>
  </section>

  <section class="docs-sec">
    <h2>The shared field context</h2>
    <p>
      Bodies, particles, relationships, measurements, metrics, feedback, and overlays all share one
      field context. The visible particle layer is a conserved pool (~130 at default density) drawn
      on a full-viewport <code>&lt;canvas&gt;</code> — one render surface among several (SVG overlays
      and DOM feedback are others). Particles are <em>one agent type</em>, not the whole substrate.
      The conserved pool carries a central law: <strong>nothing is created from nothing</strong> —
      matter is moved, captured, and released; a sink that swallows particles must later release
      them, so the count stays constant. That is what makes the field feel physical rather than
      decorative.
    </p>
  </section>

  <section class="docs-sec">
    <h2>The platform layer</h2>
    <p>
      <code>@fundamental-engine/core</code> (the core) computes the field against plain data and stays renderer-agnostic.
      <code>@fundamental-engine/dom</code> binds it to the DOM through six registries — <strong>measurement</strong>
      (frame-stable geometry), <strong>state</strong> (typed element state), <strong>feedback</strong>
      (CSS variables + thresholded events), <strong>relationships</strong> (the native href/aria/data
      graph), <strong>visual bindings</strong> (visual ↔ semantic pairing), and <strong>overlays</strong>
      (render layers) — all driven by one <strong>frame scheduler</strong> with explicit phases:
    </p>
    <div class="formula" style="--c:#4da3ff">discover → read → compute → state → write → render</div>
    <p>
      Reads happen in the read phase and writes in the write phase, so geometry reads never thrash
      against DOM writes. Since the runtime-unification phase the platform is the default for
      <code>&lt;field-root&gt;</code>; the core engine still renders the canvas. See the
      <a href="/docs/platform">platform layer</a> for the registries, scheduler, and lint.
    </p>
  </section>

  <section class="docs-sec">
    <h2>The DOM ⇄ field runtime binding</h2>
    <p>
      The rarest property of the system is a <strong>two-way binding between layout and a
      physics runtime</strong>. Fundamental is <em>not</em> a particle background: those are one-way (a
      canvas reacts to the mouse). Here the DOM <em>is</em> the runtime's geometry, and the runtime
      writes back into layout and type — a shared field context, not a decorative layer. Two flows, on
      the scheduler's read and write phases:
    </p>
    <CodeTabs variants={[{ label: 'Per frame', lang: 'js', code: pipeSnippet }]} />
    <p>
      <strong>Read (geometry in):</strong> any DOM change — reflow, transform, resize — is an
      instantaneous change to the force geometry, so animating the DOM animates the runtime for free.
      <strong>Write (feedback out):</strong> the field samples how much matter pooled on each
      <code>data-feedback</code> body and writes it back as <code>--d</code> (with the field-namespaced
      <code>--field-density</code> holding the same value).
    </p>
  </section>

  <section class="docs-sec">
    <h2>Reciprocity &amp; <code>--field-density</code></h2>
    <p>
      Reciprocity is the payoff. Opt a body in with <code>data-feedback</code> and the FeedbackRegistry
      eases the gathered density into a CSS custom property <code>--d</code> ∈ [0, 1] on the
      element — the canonical raw density channel (its field-namespaced form <code>--field-density</code>
      is written alongside it, same value). Your styles turn that number into anything — weight, glow,
      scale, color:
    </p>
    <CodeTabs variants={[{ label: 'CSS', lang: 'css', code: feedbackSnippet }]} />
    <p>
      The value is low-pass filtered (a ~0.2s time constant), so it eases rather than jitters.
      This is the sanctioned way to make type react — words gain weight where matter collects.
      (The engine never assembles particles into letterforms; words glow and grow, they are not
      drawn from dots.)
    </p>
    <SeeItLive
      slug="evidence"
      why="citations are mass — reciprocity over real data: trust you can feel in the type, no particle swarm"
    />
  </section>

  <section class="docs-sec">
    <h2>Metrics, and the lanes that stay separate</h2>
    <p>
      Density is one channel. The field also computes higher-level <strong>metrics</strong> — attention,
      priority, coherence, entropy — and writes each back as a <code>--field-&lt;metric&gt;</code> custom
      property. A <a href="/docs/patterns">pattern</a> declares which metrics it tracks; the runtime writes
      them. Below, real elements carry a runtime token (<code>data-body="attract"</code>) and a supplied
      <code>priority</code>; <code>applyPattern()</code> writes it back as <code>--field-priority</code>,
      and the CSS reads it — no canvas, no cursor needed:
    </p>
    <FieldLoopDemo
      token="attract"
      pattern="priority-well"
      metric="priority"
      items={[
        { text: 'Primary — ship the runtime', value: 0.9 },
        { text: 'Secondary — write the guide', value: 0.5 },
        { text: 'Later — tidy the changelog', value: 0.2 },
      ]}
    />
    <p>
      The vocabulary works because each word lives in exactly one <strong>lane</strong>, and the lanes
      never bleed into each other:
    </p>
    <ul class="model">
      <li><b>Concept</b> <em>describes</em> (priority, polarity, binding) — it is never executed.</li>
      <li><b>Token</b> <em>executes</em> (<code>attract</code>, <code>gravity</code>) — the only thing a <code>data-body</code> runs.</li>
      <li><b>Metric</b> <em>measures</em> (<code>--field-priority</code>, <code>--field-attention</code>) — state the field writes back, not a force.</li>
      <li><b>Diagnostic</b> <em>explains</em> (potential, topology, causality) — it inspects behavior, it does not cause it.</li>
      <li><b>Condition</b> <em>activates</em> (<code>data-when="active"</code>) — when a token is allowed to act.</li>
    </ul>
    <p class="note">
      So: a concept is not a token, a token is not a metric, and a diagnostic is not behavior. The
      <a href="/docs/patterns">pattern model</a> composes these lanes without ever inventing a new force.
    </p>
  </section>

  <section class="docs-sec">
    <h2>The orthogonal axes</h2>
    <p>The vocabulary stays small by separating four independent dimensions:</p>
    <ul class="model">
      <li>
        <b>Forces</b> — <em>what</em> a body does to nearby matter (attract, swirl, gravity,
        lens…). They compose. <a href="/docs/api/declarative#forces">Reference →</a>
      </li>
      <li>
        <b>Conditions</b> — <em>when</em> a force acts, via <code>data-when</code> (active, fast,
        slow, hot, cool, scrolling). <a href="/docs/api/declarative#conditions">Reference →</a>
      </li>
      <li>
        <b>Formations</b> — a single global bias applied to <em>every</em> particle at once
        (ambient, wells, lanes, scatter, accretion). <a href="/docs/api/declarative#conditions">Reference →</a>
      </li>
      <li>
        <b>Render modes</b> — the same physics drawn differently. Matter/structure: dots, trails,
        links, metaballs, voronoi, streamlines, field-lines, heatmap. Diagnostics (all shipped):
        force-vectors, contours, potential, energy, topology, inspector, causality, prediction.
        <a href="/docs/diagnostics">Diagnostics →</a>
      </li>
    </ul>
  </section>

  <section class="docs-sec" id="natural-fields">
    <h2>The natural model: four fields</h2>
    <p>
      Fundamental does not copy physics into the interface. It <strong>translates</strong> the four
      fundamental fields into interface behavior. Every interface already has priority, polarity,
      binding, and transformation — physics already has a language for those relations.
    </p>
    <p class="nf-doctrine">
      Natural fields are conceptual. Engine primitives are translations. Canonical forces are designed
      verbs. <strong>Natural fields are not tokens; tokens are translations.</strong> This reframe
      changes nothing the particles do — it only gives each behavior a clean place in the hierarchy:
    </p>
    <div class="formula" style="--c:#4da3ff">field → translation → runtime token → metric → diagnostic → pattern</div>

    <h3>The vocabulary lanes</h3>
    <p>
      Fundamental keeps these categories separate on purpose. A reader should never have to guess whether
      a word is a runtime token, a metric, or a diagnostic — the lane says so:
    </p>
    <VocabLegend />

    <h3>The four fields</h3>
    <div class="nf-grid">
      {NATURAL_FIELDS.map((f) => (
        <article class="nf-card" id={f.field} style={`--fc:${FIELD_COLOR[f.field]}`}>
          <h4>{f.title}</h4>
          <p class="nf-translation">{f.translation}</p>
          <p class="nf-summary">{f.summary}</p>
          <p class="nf-uses"><b>Use for</b> {f.interfaceUses.join(' · ')}</p>
          <p class="nf-expr">
            <b>Expressions</b>{' '}
            {f.expressions.length ? f.expressions.map((t) => <code>{t}</code>) : <span class="nf-none">conceptual — closest shipped analogue is <code>memory</code> decay</span>}
          </p>
        </article>
      ))}
    </div>

    <div class="callout">
      <b>Electric fields push. Magnetic fields bend. Fieldflow carries.</b> Do not make
      <code>magnetism.apply()</code> follow magnetic field lines — field-aligned transport belongs to
      <code>fieldflow</code>. And <code>attract</code> is not gravity; <code>repel</code> is not charge —
      those are designed UI verbs.
    </div>

    <h3>Author each field — the data-attribute patterns</h3>
    <p>
      You express a field's translation with <strong>data attributes on semantic HTML</strong>, using
      honest runtime tokens only. A token's field is its classification, not a separate API — there is no
      <code>&lt;gravity&gt;</code> element, only <code>data-body="gravity"</code>. Strong binding is the
      clearest case: a native <code>href</code> (or <code>data-field-relation</code> /
      <code>data-field-target</code>) <em>is</em> the relationship — the graph is discovered from the DOM,
      not declared in code.
    </p>
    <CodeTabs
      variants={[
        { label: 'Gravity → priority', lang: 'html', code: patGravity },
        { label: 'EM → polarity', lang: 'html', code: patEm },
        { label: 'Strong → binding', lang: 'html', code: patStrong },
        { label: 'Weak → decay', lang: 'html', code: patWeak },
      ]}
    />
    <p>
      Live — gravity bodies carrying a supplied <code>priority</code>; <code>applyPattern()</code>
      <ApiStamp name="applyPattern" /> writes it back as <code>--field-priority</code> and the CSS reads
      it (gravity's interface translation, running):
    </p>
    <FieldLoopDemo
      token="gravity"
      pattern="priority-well"
      metric="priority"
      items={[
        { text: 'Headline — converges attention', value: 0.9 },
        { text: 'Supporting detail', value: 0.45 },
        { text: 'Fine print', value: 0.15 },
      ]}
    />

    <SeeItLive
      slug="market"
      why="three translations on one page of real data: market cap is mass (gravity), the day's move polarizes (EM), correlated assets thread (strong)"
    />

    <h3>Fields vs primitives vs forces</h3>
    <p>Every catalog token has a place. This grouping is read straight from the engine's classification:</p>
    <div class="nf-kinds">
      {byKind.map((g) => (
        <div class="nf-kind">
          <span class="nf-kind-label">{g.label}</span>
          <div class="nf-tokens">
            {g.tokens.map((t) => (
              <code class="nf-token" style={t.field ? `--fc:${FIELD_COLOR[t.field]}` : ''} data-field={t.field ?? ''}>{t.token}</code>
            ))}
          </div>
        </div>
      ))}
    </div>

    <h3>Interface translation table</h3>
    <p>One need, separated into lanes: the runtime tokens that execute it, the metrics it measures, and the diagnostics that reveal it.</p>
    <table class="nf-table">
      <thead><tr><th>Interface need</th><th>Natural field</th><th>Runtime tokens</th><th>Metrics</th><th>Diagnostics</th></tr></thead>
      <tbody>
        {TRANSLATION.map(([need, field, tokens, metrics, diags]) => (
          <tr>
            <td>{need}</td>
            <td>{field}</td>
            <td class="nf-lane">{tokens.split(', ').map((t) => <VocabBadge kind="token" label={t} />)}</td>
            <td class="nf-lane">{metrics.split(', ').map((m) => <VocabBadge kind="metric" label={m} />)}</td>
            <td class="nf-lane">{diags.split(', ').map((d) => <VocabBadge kind="diagnostic" label={d} />)}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h3>Diagnostics by field</h3>
    <p>Each diagnostic answers “which invisible relation am I revealing?” — all shipped (<a href="/docs/diagnostics">see them live</a>). Diagnostics are inspection modes, not runtime tokens.</p>
    <table class="nf-table">
      <thead><tr><th>Diagnostic</th><th>Reveals</th><th>Field</th></tr></thead>
      <tbody>
        {DIAG.map(([d, reveals, field]) => (<tr><td><VocabBadge kind="diagnostic" label={d} /></td><td>{reveals}</td><td>{field}</td></tr>))}
      </tbody>
    </table>

    <div class="callout nf-final">
      <b>Four fields. Many expressions. One DOM runtime.</b> Every interface has priority, polarity,
      binding, and transformation. Fundamental gives those relations a field model.
    </div>
  </section>

  <section class="docs-sec" id="walkthrough">
    <h2>One element, revealed as a field participant</h2>
    <p>
      Everything above, on a single element, one layer at a time — the way the runtime sees it. The same
      ordinary HTML gains a layer per step, from plain markup to a body the field measures, drives and
      feeds back. Step through it; the feedback stage prints the value the field actually wrote.
    </p>

    <div class="nr-stage" aria-live="polite">
      <div class="nr-progress" id="nr-progress"></div>
      <div class="nr-grid">
        <div class="nr-text">
          <p class="nr-step"><span id="nr-step">1</span> / {stages.length}</p>
          <h3 id="nr-title">{stages[0].title}</h3>
          <p id="nr-body">{stages[0].body}</p>
          <a class="nr-link" id="nr-link" href="/docs/inspector" hidden>Open the Inspector →</a>
        </div>
        <div class="nr-show">
          <pre class="nr-markup"><code id="nr-markup">{stages[0].markup}</code></pre>
          <div class="nr-demo-wrap" id="nr-demo-root">
            <article class="nr-demo" id="nr-demo" data-body="attract" data-strength="0.8" data-range="280">
              <span class="nr-demo-h">Reciprocal interfaces</span>
              <span class="nr-demo-p">An ordinary element, participating.</span>
              <a class="nr-demo-rel" id="nr-demo-rel" href="#nr-demo" data-field-relation="supports" data-field-target="#nr-demo" hidden>supporting evidence</a>
            </article>
            <span class="nr-readout" id="nr-readout" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="nr-controls">
