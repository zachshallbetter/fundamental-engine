---
// The DECLARATIVE AUTHORING REFERENCE — docs-refactor Phase 2 (#997), plan §6.4/§3/§5.
//
// One consolidated, generated, searchable surface for everything an author writes in MARKUP rather
// than in code: the `[data-body]` body contract, the 37 forces, the feedback channels the field
// writes back, the conditional gates, the global formations, the render/overlay vocabularies, and
// the two custom elements. Previously this was spread across /docs/api/declarative#body-contract (the attribute
// table), /docs/api/declarative#forces (the force cards), /docs/api/declarative#conditions (conditions/formations/modes) and
// /docs/authoring (the prose) with NO per-platform information anywhere — a reader could not tell
// what a Swift or Kotlin app actually gets.
//
// EVERY support row on this page is rendered by <PlatformSupport>, which reads data/parity-matrix.json
// — the `pnpm gen:parity-matrix` output, regenerated and diffed by `pnpm check:docs`. Nothing here
// hand-types a ✓ or a ✗. The editorial content is the GROUPING and the per-row notes; membership is
// asserted at build time below, so a new `data-*` attribute cannot land without appearing here.
import DocsLayout from '../../../layouts/DocsLayout.astro';
import SeeAlso from '../../../components/SeeAlso.astro';
import StatusChip from '../../../components/StatusChip.astro';
import CodeTabs from '../../../components/CodeTabs.astro';
import PlatformSupport from '../../../components/PlatformSupport.astro';
import {
  ATTRS,
  WRITEBACK,
  RENDER_MODES,
  OVERLAY_MODES,
  FIELD_ROOT_ATTRS,
  FIELD_CELL_ATTRS,
} from '../../../lib/docs-api.ts';
import {
  MANUAL_FORCES,
  MANUAL_PRESETS,
  CONDITIONS,
  FORMATIONS,
  PALETTES,
  PALETTE_NAMES,
  FIELD_OUTPUT_VARS,
  classifyForce,
} from '@fundamental-engine/core';
import { METRIC_DOCS, METRIC_GROUPS, metricsOf } from '../../../lib/docs-metrics.ts';
import parityData from '../../../../../../data/parity-matrix.json';
import '../../../styles/force-glyphs.css';

interface Dim {
  id: string;
  label: string;
  idiom?: { js: string; swift: string; kotlin: string };
  union: string[];
  counts: { js: number; swift: number; kotlin: number };
  planes: { js: string[]; swift: string[]; kotlin: string[] };
}
const dims = parityData.dimensions as Dim[];
const dimBy = (id: string): Dim => {
  const d = dims.find((x) => x.id === id);
  if (!d) throw new Error(`docs/api/declarative: no '${id}' dimension in data/parity-matrix.json — run \`pnpm gen:parity-matrix\`.`);
  return d;
};

const declBody = dimBy('declarative-body');
const bodySpec = dimBy('body-spec');
const forceDim = dimBy('force-tokens');
const feedbackDim = dimBy('feedback-channels');
const conditionDim = dimBy('conditions');
const formationDim = dimBy('formations');
const renderDim = dimBy('render-modes');
const renderHostDim = dimBy('render-host-modes');
const overlayDim = dimBy('overlay-modes');

// ── attribute name → the matrix's canonical CONCEPT id ───────────────────────────────────────────
// The same naming-lane collapse the generator applies (`data-body` carries the token list, so its
// concept is `tokens`). Returns null for an attribute the DOM SCANNER does not read — `data-active`
// is written BY the platform on engage, never parsed as a body parameter, so it has no support row.
const ATTR_CONCEPT: Record<string, string | null> = {
  'data-body': 'tokens',
  'data-field-role': 'role',
  'data-field-boundary': 'boundary',
  'data-fmin / data-fmax': 'fmin',
  'data-active': null,
};
const conceptFor = (attrName: string): string | null => {
  if (attrName in ATTR_CONCEPT) return ATTR_CONCEPT[attrName]!;
  return attrName.replace(/^data-/, '');
};

// ── editorial grouping of the body contract ─────────────────────────────────────────────────────
// Order and grouping only — by concern, because 32 alphabetical attributes is a wall, not a
// reference. MEMBERSHIP is asserted against ATTRS below, so this list cannot drift.
const ATTR_GROUPS: { title: string; blurb: string; names: string[] }[] = [
  {
    title: 'The universal contract',
    blurb:
      'Every body reads these, whatever forces it carries. `data-body` is the only required attribute — it turns an element into a body and names the forces it exerts; the rest tune them.',
    names: ['data-body', 'data-strength', 'data-range', 'data-spin', 'data-angle', 'data-color', 'data-when', 'data-feedback'],
  },
  {
    title: 'Semantic authoring — say what you mean',
    blurb:
      'The intent lane compiles a plain-language purpose into forces, so `data-body` becomes optional. Reach for it when the *meaning* is stable and the physics is an implementation detail.',
    names: ['data-intent', 'data-intensity', 'data-risk', 'data-field-role'],
  },
  {
    title: 'Shape, species & authority',
    blurb: 'Who a body acts on, what geometry it acts from, and who owns its position.',
    names: ['data-shaped', 'data-affects', 'data-species', 'data-authority'],
  },
  {
    title: 'Per-force parameters',
    blurb:
      'Each force reads only the attributes it uses and ignores the rest, so these compose freely — a body with no `sink` token simply never reads `data-absorb`.',
    names: [
      'data-absorb',
      'data-max',
      'data-life',
      'data-cap',
      'data-budget',
      'data-sink',
      'data-pair',
      'data-twist',
      'data-scale',
      'data-screen-min',
      'data-charge-gated',
      'data-potential',
      'data-preset',
    ],
  },
  {
    title: 'Typographic reaction',
    blurb: 'The variable-font axes `--d` drives on a feedback body — type that thickens where matter gathers.',
    names: ['data-fmin / data-fmax', 'data-opsz'],
  },
  {
    title: 'Engine-set markers (read, do not author)',
    blurb:
      'These appear in your DOM but are written BY the engine or the platform. They are documented so you can read them in CSS and in the inspector — not so you can set them.',
    names: ['data-active', 'data-field-boundary'],
  },
];

// ── build-time anti-drift assertion ──────────────────────────────────────────────────────────────
// The grouping above is hand-ordered; its MEMBERSHIP is not allowed to be. If a `data-*` attribute is
// added to (or removed from) the engine — which `check:docs` already forces into ATTRS — the site
// build FAILS here rather than rendering a reference that silently omits it.
const attrByName = new Map(ATTRS.map((a) => [a.name, a]));
const groupedNames = ATTR_GROUPS.flatMap((g) => g.names);
const missingFromGroups = ATTRS.map((a) => a.name).filter((n) => !groupedNames.includes(n));
const extraInGroups = groupedNames.filter((n) => !attrByName.has(n));
if (missingFromGroups.length || extraInGroups.length) {
  throw new Error(
    'docs/api/declarative: ATTR_GROUPS has drifted from the ATTRS table in lib/docs-api.ts.\n' +
      (missingFromGroups.length ? `  In ATTRS but not grouped on this page: ${missingFromGroups.join(', ')}\n` : '') +
      (extraInGroups.length ? `  Grouped on this page but not in ATTRS: ${extraInGroups.join(', ')}\n` : '') +
      '  Add the attribute to the right group (or remove it) — do not delete this check.',
  );
}

// ── the feedback channels → CSS custom properties map ────────────────────────────────────────────
// Which var(s) the DOM sink writes for each channel, read off packages/core/src/engine/feedback-sink.ts.
// The CHANNEL is the cross-platform capability; the CSS variable is the JS DELIVERY of it.
const CHANNEL_VARS: Record<string, string[]> = {
  density: ['--d', '--field-density'],
  heatmapDensity: ['--field-heatmap-density'],
  load: ['--load'],
  lit: ['--lit'],
  entropy: ['--entropy'],
  coherence: ['--coherence'],
  temperature: ['--temperature'],
};
const writebackBy = new Map(WRITEBACK.map((w) => [w.name, w]));
// Every channel must map to at least one var the sink actually writes (WRITEBACK is itself gated by
// check:docs against feedback-sink.ts), so a renamed var fails the build instead of the reader.
for (const ch of feedbackDim.union) {
  const vars = CHANNEL_VARS[ch];
  if (!vars) throw new Error(`docs/api/declarative: feedback channel '${ch}' has no CSS-variable mapping — update CHANNEL_VARS.`);
  for (const v of vars) {
    if (!writebackBy.has(v)) throw new Error(`docs/api/declarative: '${v}' is not in the WRITEBACK table — feedback-sink.ts changed; update lib/docs-api.ts.`);
  }
}

const FORCE_FAMILIES = [
  {
    key: 'canonical',
    label: 'Canonical nine',
    blurb:
      'The bounded, UI-legible verbs — what a body does to nearby matter. Designed runtime tokens, not natural translations.',
  },
  {
    key: 'natural',
    label: 'Natural & derived',
    blurb:
      'Runtime tokens drawn from physics: some express a fundamental field (gravity, charge, magnetism), others are derived behaviors (thermal, diffuse, collide), a transport (propagate), or a metric (memory). The per-card badge tells you which.',
  },
  {
    key: 'extended',
    label: 'Designed extended',
    blurb:
      'Pure per-particle effects — bends, gates, transitions, modifiers, and strong/weak analogues.',
  },
] as const;

// ── the force cards (merged from the retired /docs/api/declarative#forces, Phase 6 #1001) ────────────────────
// The natural-field badge per force comes from the engine's own classification (config/manual.ts), so
// a re-classified token re-badges itself here with no edit.
const FIELD_COLOR: Record<string, string> = {
  gravity: '#4da3ff',
  electromagnetic: '#2dd4bf',
  strong: '#a78bfa',
  weak: '#ff9d5c',
};
const FIELD_LABEL: Record<string, string> = {
  gravity: 'gravity',
  electromagnetic: 'EM',
  strong: 'strong',
  weak: 'weak',
};
const badgeFor = (token: string) => {
  const { kind, field } = classifyForce(token);
  return field
    ? { text: FIELD_LABEL[field] ?? field, color: FIELD_COLOR[field], title: `${kind} · ${field} field` }
    : { text: kind ?? '', color: '', title: kind ?? '' };
};
// The forces the <field-cell> poster engine can render live (packages/elements cell-force.ts).
const CELL_FORCES = new Set(['attract', 'repel', 'swirl', 'gravity', 'stream', 'buoyancy', 'tether']);

// ── the preset catalog (merged from the retired /docs/api/declarative#presets, Phase 6 #1001) ────────────────
// `data-preset` is part of the markup contract (it is in ATTRS above), so the composites it names
// belong on this page rather than on one of their own.
const PRESET_COLORS: Record<string, string> = {
  blackhole: '#fbbf24', whitehole: '#e0f2fe', wormhole: '#8b5cf6', star: '#6366f1', quasar: '#fbbf24',
  galaxy: '#a78bfa', nebula: '#38bdf8', tornado: '#2dd4bf', fountain: '#7dd3fc',
};
const presetUsage = `<div data-preset="blackhole"></div>`;

// ── the --field-* metric lane (merged from the retired /docs/api/declarative#feedback, Phase 6 #1001) ─────────
// Membership is asserted against the engine's own enumeration: a metric the platform writes but
// nobody documented fails the build here rather than reaching a reader as a mystery variable.
const undocumentedMetrics = FIELD_OUTPUT_VARS.filter((v: string) => !METRIC_DOCS[v]);
if (undocumentedMetrics.length) {
  throw new Error(
    `docs/api/declarative: FIELD_OUTPUT_VARS carries metrics with no entry in lib/docs-metrics.ts: ${undocumentedMetrics.join(', ')}.\n` +
      '  Document them (range, cadence, what it measures, what to use it for) — do not delete this check.',
  );
}
const metricGroups = METRIC_GROUPS.map((g) => ({ ...g, vars: metricsOf(g.source, FIELD_OUTPUT_VARS) }));

const densityAmpCss = `/* --d (and its namespaced twin --field-density) rests SMALL by design —
   fractions of 1. Scale it once, here, instead of sprinkling a magic
   multiplier through every consumer. clamp() gives a calm floor and a
   hard ceiling. */
[data-feedback] {
  --d-amp: clamp(0, calc(var(--d, 0) * 12), 1);   /* raw fraction → ~0..1 */
}

/* drive the visible reaction off the amplified value, not the raw one */
.hero-mass {
  transform: translateY(calc(var(--d-amp) * -8px));
  opacity: calc(0.4 + var(--d-amp) * 0.6);
}`;

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const golden = parityData.conformanceGolden as { forces: string[]; count: number };

// the one genuine declarative-host gap worth calling out by name, computed not asserted
const kotlinHostRenderGap = renderDim.planes.kotlin.filter((m) => m !== 'none' && !renderHostDim.planes.kotlin.includes(m));

const bodyHtml = `<!-- a body is an ordinary element with a contract on it -->
<article
  data-body="attract swirl"
  data-strength="0.8"
  data-range="240"
  data-spin="1.2"
  data-when="active"
  data-feedback
>
  <h2>Gravity well</h2>
</article>`;

const bodySwift = `// SwiftUI: the same contract as a view modifier
Text("Gravity well")
    .fieldBody(
        tokens: ["attract", "swirl"],
        strength: 0.8,
        range: 240,
        feedback: true
    ) { channels in
        // the feedback channels, per frame — the CSS vars' native twin
        density = channels.density ?? 0
    }`;

const bodyKotlin = `// Compose: the same contract as a Modifier
Text(
    text = "Gravity well",
    modifier = Modifier.fieldBody(
        tokens = listOf("attract", "swirl"),
        strength = 0.8f,
        range = 240f,
        spin = 1.2f,
    ),
)
// no per-body feedback callback on the modifier yet — read feedback through the
// FeedbackSink / StateRegistry on the platform layer instead.`;

const feedbackCss = `/* the reciprocal half: the field writes, your CSS reads */
[data-feedback] {
  /* --d rests as a small fraction — amplify once, here, not in every consumer */
  --d-amp: clamp(0, calc(var(--d, 0) * 12), 1);
}
article[data-feedback] h2 {
  font-variation-settings: 'wght' calc(400 + var(--d-amp) * 300);
  opacity: calc(0.6 + var(--d-amp) * 0.4);
}`;
---

<DocsLayout
  title="Fundamental — the declarative authoring reference"
  description="Everything you write in markup, in one place: the [data-body] contract (every data-* attribute), the 37 forces, the feedback channels the field writes back, conditions, formations, render and overlay vocabularies, and the two custom elements — each with a generated JS · Swift · Kotlin support row."
>
  <header class="docs-hero">
    <p class="kicker">API reference</p>
    <h1>The <span class="accent">declarative</span> authoring reference</h1>
    <StatusChip label="Shipped · support rows generated" tone="stable" />
    <p class="lede">
      Most of Fundamental is authored in markup, not in code: you put a contract on an element and the
      field reads it. This is that contract, whole — the {ATTRS.length} <code>data-*</code> attributes, the
      {MANUAL_FORCES.length} forces, the {feedbackDim.union.length} feedback channels the field writes back, and the
      vocabularies they draw on. <strong>Every entry carries a per-platform support row</strong>, rendered from
      the generated <a href="/docs/api/parity">parity matrix</a> — so you can see what a Swift or Kotlin app
      actually gets before you design around it.
    </p>
  </header>

  <div class="callout">
    <b>How to read a support row.</b> <span class="parity-chip parity-yes">JS ✓</span> means the capability
    exists on that plane — <em>however that plane spells it</em>. The three planes are different idioms, and an
    idiom difference is an <strong>equivalent</strong>, not a gap: the matrix collapses
    <code>data-body</code>, <code>.fieldBody(tokens:)</code> and <code>Modifier.fieldBody(tokens)</code> to one
    capability before comparing. A <span class="parity-chip parity-no">Kotlin —</span> is therefore a
    <strong>real</strong> gap: the plane has no way to express that capability at that layer today. Nothing on
    this page is hand-typed; the chips are read out of <code>data/parity-matrix.json</code>, which
    <code>pnpm check:docs</code> regenerates and diffs on every CI run.
  </div>

  <section class="docs-sec">
    <h2 id="a-body-three-ways">A body, three ways</h2>
    <p>
      Same contract, three idioms. The DOM scan finds bodies by attribute; SwiftUI and Compose attach them
      through a view modifier. Underneath, all three build the same body and run the same force math — the
      cross-plane conformance golden pins {golden.count} forces (<code>{golden.forces.join(', ')}</code>) to
      identical output at <code>depth: 0</code>.
    </p>
    <CodeTabs
      variants={[
        { label: 'HTML', lang: 'html', code: bodyHtml },
        { label: 'Swift', lang: 'swift', code: bodySwift },
        { label: 'Kotlin', lang: 'kotlin', code: bodyKotlin },
      ]}
    />
    <table class="matrix">
      <thead>
        <tr><th>Plane</th><th>How a body is declared</th><th>Contract parameters at that layer</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><b>JS</b></td>
          <td>{declBody.idiom?.js}</td>
          <td><code>{declBody.counts.js}</code> of {declBody.union.length}</td>
        </tr>
        <tr>
          <td><b>Swift</b></td>
          <td>{declBody.idiom?.swift}</td>
          <td><code>{declBody.counts.swift}</code> of {declBody.union.length}</td>
        </tr>
        <tr>
          <td><b>Kotlin</b></td>
          <td>{declBody.idiom?.kotlin}</td>
          <td><code>{declBody.counts.kotlin}</code> of {declBody.union.length}</td>
        </tr>
      </tbody>
    </table>
    <p>
      <b>Read that honestly.</b> The DOM scan is the widest declarative surface by a long way — the attribute
      lane costs nothing to extend, so it carries the whole contract. The SwiftUI and Compose modifiers expose
      the common core (<code>tokens</code>, <code>strength</code>, <code>range</code>, plus
      <code>feedback</code> on Swift and <code>spin</code> on Kotlin); everything else on those planes is
      reached through the <a href="#programmatic">programmatic body spec</a>, which is much closer to parity.
      The gap is in the <em>declarative sugar</em>, not in the engine.
    </p>
  </section>

  <section class="docs-sec">
    <h2 id="body-contract">The body contract — every <code>data-*</code> attribute</h2>
    <p>
      A body is configured entirely in markup. Each force reads only the attributes it uses and ignores the
      rest, so you can set a few and compose freely. The support row on each entry is for the
      <strong>declarative</strong> layer specifically — see <a href="#programmatic">the programmatic spec</a>
      for what a port can express in code.
    </p>
    {
      ATTR_GROUPS.map((g) => (
        <>
          <h3>{g.title}</h3>
          <p>{g.blurb}</p>
          <dl class="api-table">
            {g.names.map((name) => {
              const a = attrByName.get(name)!;
              const concept = conceptFor(name);
              return (
                <div class="api-row" id={`attr-${name.replace(/[^\w-]+/g, '-')}`}>
                  <dt class="k">
                    <code>{a.name}</code>
                    <span class="ty">
                      {a.type}
                      {a.def ? <> · <b>default {a.def}</b></> : null}
                    </span>
                    {concept ? (
                      <PlatformSupport dimension="declarative-body" symbol={concept} />
                    ) : (
                      <span class="parity-chips">
                        <span class="parity-chip parity-no" title="written by the engine, not authored">
                          engine-set
                        </span>
                      </span>
                    )}
                  </dt>
                  <dd class="d">{a.desc}</dd>
                </div>
              );
            })}
          </dl>
        </>
      ))
    }
  </section>

  <section class="docs-sec">
    <h2 id="programmatic">The same contract without an element</h2>
    <p>
      A body does not need a backing element. <code>addBody</code> takes a <code>BodySpec</code> — the same
      contract, supplied directly, with a <code>rect</code> callback as the position source. This is how a
      Three.js mesh, a SwiftUI canvas, or a headless host participates. The ports are near-parity here, which is
      why a Swift or Kotlin app is not limited to the four-parameter modifier above.
    </p>
    <dl class="api-table">
      {
        bodySpec.union.map((field) => (
          <div class="api-row">
            <dt class="k">
              <code>{field}</code>
              <PlatformSupport dimension="body-spec" symbol={field} />
            </dt>
            <dd class="d">
              {field === 'tokens' && 'The force ids this body emits — a space-joined string or an array. The only required field besides the position source.'}
              {field === 'strength' && 'Overall force magnitude; scales every token on the body.'}
              {field === 'range' && 'Radius of influence, in field pixels.'}
              {field === 'spin' && 'Rotation sign and scale for swirl / lens / charge / magnetism.'}
              {field === 'angle' && 'Heading in degrees for the directional forces (stream, jet, gate, shear, align). Kotlin spells it angleDeg.'}
              {field === 'color' && 'Tint carried for pigment transport, and the accent override on engage. Kotlin spells it tint.'}
              {field === 'identity' && 'First-class identity — a stable id (plus optional namespace / kind / host) so snapshots, diff, replay and relationships can reference the body rather than the handle. Omitted, the engine derives a deterministic body-N.'}
              {field === 'data' && 'An arbitrary record carried with the body and surfaced on its handle. Opaque to the engine.'}
              {field === 'feedback' && 'The per-body feedback callback (onFeedback) — this body’s channels, every frame, demultiplexed from the global sink. The Kotlin BodySpec does not carry one yet; use a FeedbackSink or the StateRegistry on the platform layer there.'}
              {field === 'authority' && 'Who owns the body’s position: anchored (measured from the host rect), kinematic (the engine writes the visual transform), or dynamic (the engine owns position and velocity and the body moves under the net field). JS only today — the ports treat every programmatic body as anchored. Experimental.'}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="docs-sec">
    <h2 id="forces">The {MANUAL_FORCES.length} forces</h2>
    <p>
      Compose them on any <code>data-body</code> element, space-separated. Every token is a real, passported
      engine token and every one of them ships on all three planes — this is the part of the surface with no
      parity story to tell, and the conformance golden proves the math <em>agrees</em>, not just that the names
      match. Each card is generated from the engine's own catalog: the per-frame law, the attributes it reads,
      a real-world use, and its support row.
    </p>
    <div class="callout">
      <b>Runtime tokens only.</b> Each card carries a badge from the engine's classification — either a
      fundamental-field parent (<span class="rc-kind" style="--kc:#4da3ff">gravity</span>
      <span class="rc-kind" style="--kc:#2dd4bf">EM</span>
      <span class="rc-kind" style="--kc:#a78bfa">strong</span>
      <span class="rc-kind" style="--kc:#ff9d5c">weak</span>) or a kind
      (<span class="rc-kind">designed</span>, <span class="rc-kind">derived</span>,
      <span class="rc-kind">transport</span>, <span class="rc-kind">metric</span>). Only
      <b>gravity / electromagnetic / strong / weak</b> are conceptual natural fields;
      <code>charge</code> and <code>magnetism</code> are electromagnetic <em>expressions</em>, while
      <code>thermal</code>, <code>diffuse</code>, and <code>collide</code> are derived behaviors. Concepts
      (<code>spring</code>, <code>orbit</code>), metrics (<code>mass</code>) and diagnostics
      (<code>potential</code>) are <em>not</em> tokens and do not appear here — see the
      <a href="/docs/concepts#natural-fields">four-field model</a> and the
      <a href="/docs/patterns">pattern model</a>.
    </div>
    {
      FORCE_FAMILIES.map((fam) => {
        const list = MANUAL_FORCES.filter((f) => f.family === fam.key);
        return (
          <>
            <h3>
              {fam.label} <span style="color:var(--text-4)">({list.length})</span>
            </h3>
            <p>{fam.blurb}</p>
            <div class="ref-grid">
              {list.map((f) => (
                <article class="ref-card" id={`force-${f.token}`} style={`--c:${f.color}`}>
                  <div class="rc-head">
                    <i class={`fg fg-${f.token}`} style={`--fc:${f.color}`} />
                    <code>{f.token}</code>
                    {(() => {
                      const b = badgeFor(f.token);
                      return b.text ? (
                        <span class="rc-kind" style={b.color ? `--kc:${b.color}` : ''} title={b.title}>
                          {b.text}
                        </span>
                      ) : null;
                    })()}
                    {CELL_FORCES.has(f.token) && <span class="rc-live">live</span>}
                  </div>
                  {CELL_FORCES.has(f.token) && (
                    <div class="rc-cell">
                      <field-cell force={f.token} color={f.color} />
                    </div>
                  )}
                  <code class="rc-formula">{f.formula}</code>
                  <p class="rc-desc">{cap(f.desc)}.</p>
                  <div class="rc-meta">
                    {f.attrs.length ? (
                      f.attrs.map((a) => <span class="chip">data-{a}</span>)
                    ) : (
                      <span class="chip">box-sized — no params</span>
                    )}
                  </div>
                  <p class="rc-eg">{f.example}</p>
                  <div class="rc-support">
                    <PlatformSupport dimension="force-tokens" symbol={f.token} />
                  </div>
                </article>
              ))}
            </div>
          </>
        );
      })
    }
  </section>

  <section class="docs-sec">
    <h2 id="presets">Presets — composites, not new engine code</h2>
    <p>
      <code>data-preset</code> expands to several <em>co-located bodies</em> — one primitive each, sharing the
      element's rectangle. It is pure composition: the engine never grows to add one, which is why a preset
      needs no support row of its own beyond the tokens it composes (all of which ship on all three planes).
    </p>
    <CodeTabs variants={[{ label: 'HTML', lang: 'html', code: presetUsage }]} />
    <div class="ref-grid">
      {
        MANUAL_PRESETS.map((p) => (
          <article class="ref-card" id={`preset-${p.name}`} style={`--c:${PRESET_COLORS[p.name]}`}>
            <div class="rc-head">
              <i class={`fgp fgp-${p.name}`} style={`--fc:${PRESET_COLORS[p.name]}`} />
              <code>{p.name}</code>
            </div>
            <p class="rc-desc">{cap(p.desc)}.</p>
            <div class="rc-meta">
              {p.tokens.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </div>
            <p class="rc-eg">{p.example}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="docs-sec">
    <h2 id="feedback">Feedback channels — what the field writes back</h2>
    <p>
      Reciprocity has two halves. Bodies bend the field through <code>data-*</code>; the field bends them back
      through <strong>feedback channels</strong> — a plain-data record the engine produces for every opted-in
      body, every frame. The record is identical on all three planes. Only the <em>delivery</em> differs, and
      that difference is the single most important thing to know before porting a design:
    </p>
    <table class="matrix">
      <thead>
        <tr><th>Plane</th><th>How the channels reach you</th><th>Channels</th></tr>
      </thead>
      <tbody>
        <tr><td><b>JS</b></td><td>{feedbackDim.idiom?.js}</td><td><code>{feedbackDim.counts.js}</code></td></tr>
        <tr><td><b>Swift</b></td><td>{feedbackDim.idiom?.swift}</td><td><code>{feedbackDim.counts.swift}</code></td></tr>
        <tr><td><b>Kotlin</b></td><td>{feedbackDim.idiom?.kotlin}</td><td><code>{feedbackDim.counts.kotlin}</code></td></tr>
      </tbody>
    </table>
    <p>
      On the web the channels arrive as CSS custom properties on the element itself, so a reaction is written in
      CSS and never touches JavaScript. On Swift and Kotlin there is no CSS to write into, so the same record
      arrives as a value — a closure parameter or a registry entry — and you drive the view from it.
    </p>
    <CodeTabs variants={[{ label: 'CSS', lang: 'css', code: feedbackCss }]} />

    <h3>The channels</h3>
    <dl class="api-table">
      {
        feedbackDim.union.map((ch) => {
          const vars = CHANNEL_VARS[ch]!;
          const primary = writebackBy.get(vars[0]!)!;
          return (
            <div class="api-row" id={`channel-${ch}`}>
              <dt class="k">
                <code>{ch}</code>
                <span class="ty">CSS <b>{vars.join(' · ')}</b></span>
                <PlatformSupport dimension="feedback-channels" symbol={ch} />
              </dt>
              <dd class="d">{primary.desc}</dd>
            </div>
          );
        })
      }
    </dl>
    <div class="callout">
      <b>Two channels the web adds on top.</b> <code>--field-density</code> is a second custom property carrying
      the <em>same</em> value as <code>--d</code> (they are written in one sink call and never disagree — see the
      canonical <a href="https://github.com/zachshallbetter/fundamental-engine/blob/main/docs/canonical/feedback-channels.md">feedback-channels</a> note),
      and <code>--mass</code> is a <b>retired</b> name: no engine path writes it any more — only the
      <code>lintFeedbackEngineOwned</code> rule still reserves it so an old stylesheet that
      <em>sets</em> it is flagged. Style off <code>--load</code>.
    </div>

    <h3 id="density">Reading <code>--d</code>: the density signal, and how to scale it</h3>
    <p>
      Density is the channel most pages reach for first, and the one most often read wrongly — so this is the
      one place the story is told in full (it used to be told, inconsistently, on six pages).
      <strong>Resting <code>--d</code> is small by design.</strong> The value is an eased density in
      <code>0..1</code>, but at rest it sits in the <em>low fractions</em> — often around
      <code>0.04–0.05</code>. It is not a normalized "how lit is this body" gauge you can map straight onto
      <code>0..1</code> opacity; it is the raw fraction of the pool a body has gathered, kept calm on purpose
      so ambient drift doesn't flicker your type.
    </p>
    <p>
      What moves it: the body's per-frame matter <strong>count</strong> within range (driven by the field's
      <code>density</code> option and the body's <code>strength</code> / <code>range</code> — a stronger,
      wider body gathers more), plus a fixed bump while the body is <strong>engaged</strong>
      (<code>data-active</code> / hover adds a large step). Concretely the eased target is roughly
      <code>count / 20 + (engaged ? 0.45 : 0)</code>, clamped to <code>0..1</code> — so a resting body with a
      handful of nearby particles lands near <code>0.05</code>, and engagement is what pushes it toward the
      top of the range. Raising the field's <code>density</code> or the body's <code>strength</code> lifts the
      resting floor, but only so far: the design intent is a quiet baseline, not a hot one.
    </p>
    <p>
      So <strong>amplify in CSS</strong> rather than expecting a pre-scaled <code>0..1</code>. Scale
      <code>--d</code> once into a derived variable, then drive every reaction off that — the magic number
      lives in one place instead of being sprinkled through the stylesheet:
    </p>
    <CodeTabs variants={[{ label: 'CSS', lang: 'css', code: densityAmpCss }]} />
    <p>
      Tune the multiplier to the resting <code>--d</code> you actually observe for your field's
      <code>density</code> and body parameters — there is no universal constant, because the resting count
      depends on your scene. For a binary "is this body engaged" gate that needs no scaling, read the
      engine's thresholded <code>data-field-density="high"</code> state attribute instead of the numeric var.
    </p>

    <h3 id="metrics">The <code>--field-*</code> metric lane</h3>
    <p>
      Beside the channels above there is a second family of custom property: the <code>--field-*</code>
      <strong>metrics</strong>, {FIELD_OUTPUT_VARS.length} names enumerated from the engine's own
      <code>FIELD_OUTPUT_VARS</code> (this page fails its build if one of them is undocumented). They are
      <strong>web-only</strong> — the ports have no equivalent lane — which is why these rows carry no
      support chips.
    </p>
    <div class="callout callout--warn">
      <b>Not all of these are live, and the difference matters.</b> The channels above are written on any
      <code>[data-feedback]</code> body with nothing else attached. Of the metric lane, exactly
      <strong>one</strong> behaves that way: <code>--field-density</code>, which is the namespaced twin of
      <code>--d</code>. Five more are written by the <em>pattern metric pipeline</em> — only while a
      pattern, a <code>bindData</code> binding or <code>bindFieldNav</code> is attached. The remaining
      {metricGroups.find((g) => g.source === 'reserved')!.vars.length} are <strong>reserved names that
      nothing writes yet</strong>. This page said otherwise until Phase 6 (#1001): it described the whole
      lane as written every frame, which sent readers to style off variables that are permanently
      undefined. Each group below says which it is.
    </div>
    {
      metricGroups.map((g) => (
        <>
          <h4>{g.title}</h4>
          <p>{g.blurb}</p>
          <dl class="api-table">
            {g.vars.map((v) => (
              <div class="api-row" id={v.slice(2)}>
                <dt class="k">
                  <code>{v}</code>
                  <span class="ty">
                    {METRIC_DOCS[v]!.range} · {METRIC_DOCS[v]!.written}
                  </span>
                </dt>
                <dd class="d">
                  {METRIC_DOCS[v]!.summary}
                  <span class="m-use">
                    <b>Use for</b> {METRIC_DOCS[v]!.use}
                  </span>
                </dd>
              </div>
            ))}
          </dl>
        </>
      ))
    }
  </section>

  <section class="docs-sec">
    <h2 id="conditions">Conditional gates — <code>data-when</code></h2>
    <p>
      Gate any force on a condition; it acts only while the condition holds. The selective gates are evaluated
      per <em>particle</em>, so one body can pull only the fast matter passing it. Full parity: all
      {conditionDim.union.length} gates exist on all three planes, resolved from the same built-in registry.
    </p>
    <dl class="api-table">
      {
        CONDITIONS.filter((c) => c.id).map((c) => (
          <div class="api-row" id={`when-${c.id}`}>
            <dt class="k">
              <code>{c.id}</code>
              <span class="ty">{c.selective ? 'per particle' : 'per body'}</span>
              <PlatformSupport dimension="conditions" symbol={c.id} />
            </dt>
            <dd class="d">{cap(c.desc)}.</dd>
          </div>
        ))
      }
    </dl>
    <p>
      An empty gate (the default) always passes, and an <em>unknown</em> gate name also passes — a typo weakens
      nothing silently, it just stops gating. <b>The built-in set is the whole set:</b> there is no public API
      for registering a condition of your own. <code>createRegistry().condition()</code> exists, but
      <code>createField</code> builds its registry internally and takes no registry option, so a custom gate
      cannot reach a field you created. Gate on state you already control instead — toggle
      <code>data-when</code>, or swap the token list.
    </p>
  </section>

  <section class="docs-sec">
    <h2 id="formations">Global formations</h2>
    <p>
      A formation is a bias applied to every <em>free</em> particle at once — the whole-field weather, orthogonal
      to what any individual body does. Set it declaratively with <code>&lt;field-root formation&gt;</code> or live
      with <code>setFormation</code>; the engine eases between presets so transitions glide rather than snap. Full
      parity across the planes.
    </p>
    <dl class="api-table">
      {
        FORMATIONS.map((f) => (
          <div class="api-row" id={`formation-${f.id}`}>
            <dt class="k">
              <code>{f.id}</code>
              <span class="ty">{f.cue}</span>
              <PlatformSupport dimension="formations" symbol={f.id} />
            </dt>
            <dd class="d">
              drift <code>{f.preset.driftX}</code> · wander <code>{f.preset.wander}</code> · orbit{' '}
              <code>{f.preset.orbit}</code> · spread <code>{f.preset.spread}</code> · converge{' '}
              <code>{f.preset.conv}</code>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="docs-sec">
    <h2 id="render">Render modes — the underlay</h2>
    <p>
      The render mode is how the field <em>draws</em>, set declaratively as <code>&lt;field-root render&gt;</code> (or
      the <code>render</code> option, or <code>setRender</code> live). It changes nothing about the physics.
    </p>
    <p>
      This is the one part of the declarative surface where a capability can go missing in two different
      places, so each entry carries <strong>two</strong> rows. <b>Accepted</b> is whether the plane's engine
      takes the mode at all; <b>Drawn</b> is whether that plane's declarative host actually paints it. They are
      not the same question:
      {
        kotlinHostRenderGap.length > 0 ? (
          <Fragment>
            {' '}the Kotlin core accepts <code>{kotlinHostRenderGap.join(', ')}</code>, which the Compose{' '}
            <code>FieldView</code> has no draw path for — exactly the way a multi-hue palette was once
            accepted and then collapsed to a single accent by an Android host.
          </Fragment>
        ) : (
          <Fragment>
            {' '}the Compose <code>FieldView</code> once declared a render enum of its own and drew four of
            the seven modes its core accepted, so three were unreachable from a Compose app — the same
            shape of gap as the palette an Android host once collapsed to a single accent. Both are
            closed, and these rows are what keeps them closed.
          </Fragment>
        )
      }
    </p>
    <dl class="api-table">
      {
        RENDER_MODES.map((m) => (
          <div class="api-row" id={`render-${m.name}`}>
            <dt class="k">
              <code>{m.name}</code>
              <span class="ty">accepted</span>
              <PlatformSupport dimension="render-modes" symbol={m.name} />
              {m.name !== 'none' && (
                <>
                  <span class="ty">drawn by the host</span>
                  <PlatformSupport dimension="render-host-modes" symbol={m.name} />
                </>
              )}
            </dt>
            <dd class="d">{m.desc}</dd>
          </div>
        ))
      }
    </dl>
    <p>
      The ports draw exactly this shared vocabulary — no host-local extras. Compose used to add a
      <code>glow</code> mode of its own that no other plane defined and no conformance test covered; it is
      retired in favour of the <code>dots</code> mode with a raised <code>particleGlow</code>, which is the
      same soft additive bloom expressed in the shared vocabulary.
    </p>
  </section>

  <section class="docs-sec">
    <h2 id="overlay">Overlay readings — the diagnostics surface</h2>
    <p>
      Readings are drawn in <em>front</em> of content on a second canvas, and they are additive: pass one, or a
      space-separated stack in <code>&lt;field-root overlay&gt;</code>, and they compose. All
      {overlayDim.union.length} readings are declared on all three planes.
      <b> On the web, an overlay is a silent no-op unless the field was created with an
      <code>overlayCanvas</code></b> — <code>&lt;field-root&gt;</code> manages that canvas for you; a bare
      <code>createField</code> does not.
    </p>
    <dl class="api-table">
      {
        OVERLAY_MODES.map((m) => (
          <div class="api-row" id={`overlay-${m.name}`}>
            <dt class="k">
              <code>{m.name}</code>
              <PlatformSupport dimension="overlay-modes" symbol={m.name} />
            </dt>
            <dd class="d">{m.desc}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="docs-sec">
    <h2 id="palettes">Palettes</h2>
    <p>
      The color template the travelling accent journeys through — set it declaratively as
      <code>&lt;field-root palette&gt;</code> or live with <code>setPalette(name)</code>. A palette is
      presentation, not physics; a plane whose host collapses one to a single accent is a host gap, which is
      exactly the class of drift the parity matrix now tracks.
    </p>
    <dl class="api-table">
      {
        PALETTE_NAMES.map((name: string) => (
          <div class="api-row" id={`palette-${name}`}>
            <dt class="k">
              <code>{name}</code>
            </dt>
            <dd class="d rc-meta">
              {PALETTES[name].map((hex: string) => (
                <span class="chip" style={`border-color:${hex}; color:${hex}`}>
                  {hex}
                </span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="docs-sec">
    <h2 id="elements">The custom elements</h2>
    <p>
      Two elements ship. <code>&lt;field-root&gt;</code> is the page field — it mirrors every
      <code>createField</code> option as a kebab-case attribute, and setting one after mount calls the matching
      setter on the live handle, so markup and runtime control are the same surface.
      <code>&lt;field-cell&gt;</code> is something else entirely: a standalone, in-frame poster that renders
      <em>one</em> force with its own small particle pool, its own budget and its own in-view gating. A page can
      carry dozens without them sharing or starving one pool. Both are web-only by construction.
    </p>

    <h3><code>&lt;field-root&gt;</code></h3>
    <dl class="api-table">
      {
        FIELD_ROOT_ATTRS.map((a) => (
          <div class="api-row" id={`field-root-${a.name}`}>
            <dt class="k">
              <code>{a.name}</code>
              <span class="ty">option <b>{a.option}</b></span>
            </dt>
            <dd class="d">{a.desc}</dd>
          </div>
        ))
      }
    </dl>

    <h3><code>&lt;field-cell&gt;</code></h3>
    <dl class="api-table">
      {
        FIELD_CELL_ATTRS.map((a) => (
          <div class="api-row" id={`field-cell-${a.name}`}>
            <dt class="k">
              <code>{a.name}</code>
              <span class="ty">
                {a.type}
                {a.def ? <> · <b>default {a.def}</b></> : null}
              </span>
            </dt>
            <dd class="d">{a.desc}</dd>
          </div>
        ))
      }
    </dl>
  </section>

