---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import StatusChip from '../../../components/StatusChip.astro';
import { MANUAL_FORCES, MANUAL_PRESETS, MANUAL_CONDITIONS, FORMATIONS, PALETTE_NAMES } from '@fundamental-engine/core';
import { RENDER_MODES } from '../../../lib/docs-api.ts';

const cards = [
  { href: '/docs/api/imperative#options', t: 'createField & options', d: 'The entry points and every FieldOptions knob. Core requires a host; @fundamental-engine/vanilla and <field-root> wire browserHost() for you.' },
  { href: '/docs/api/imperative#handle', t: 'FieldHandle', d: 'The object every entry point returns — drive the field at runtime.' },
  { href: '/docs/api/declarative', t: 'Declarative authoring reference', d: 'Everything written in markup, in one place — the [data-body] contract, the forces, the feedback channels, conditions, formations, render/overlay vocab and both custom elements, each with a generated JS · Swift · Kotlin support row.' },
  { href: '/docs/api/imperative', t: 'Imperative API reference', d: 'Everything reached from code, in one place — createField and its options, the whole FieldHandle, the sampling and observable reads (query, snapshot, diff, replay, projections), the capability-scoped agent view, policy and budgets, the body handle and the event bus, each with a generated JS · Swift · Kotlin support row.' },
  { href: '/docs/api/declarative#body-contract', t: 'data-* attributes', d: 'Every attribute a body reads, and which force reads which.' },
  { href: '/docs/api/declarative#forces', t: `Forces (${MANUAL_FORCES.length})`, d: 'The full catalog — law, attributes, and example per force.' },
  { href: '/docs/api/declarative#presets', t: `Presets (${MANUAL_PRESETS.length})`, d: 'Whole compositions as one attribute. No new engine code.' },
  { href: '/docs/api/declarative#conditions', t: 'Conditions, formations & modes', d: 'The orthogonal axes — when, field-wide, and how it draws.' },
  { href: '/docs/api/imperative#types', t: 'Types', d: 'Core types (Body, Particle, Force, Env) and platform types.' },
  { href: '/docs/api/stability', t: 'API stability', d: 'The frozen 0.x public surface, the experimental surface, and the compatibility rules — enforced by pnpm check:api.' },
  { href: '/docs/platform', t: '@fundamental-engine/dom', d: 'DOM participation: the FrameScheduler + six registries (measurement, state, feedback, relationships, visual bindings, overlays) + lintPlatform().' },
  { href: '/docs/api/parity', t: 'Platform parity matrix', d: 'Which FieldHandle methods ship on Three.js, Swift, and Kotlin — generated from the ports, with the current gaps named. Not full parity: the JS surface has grown since the ports last caught up.' },
  { href: '/docs/api/declarative#feedback', t: 'Metrics & diagnostics', d: 'The observability surface: inspectBudget, energyReport, lintPlatform, and the live --field-* feedback channels.' },
  { href: '/docs/api/utilities', t: 'Platform utilities', d: 'withFlip (FLIP animation), allocateAttention (conserved budget), threadOverlay, bindFieldNav, QualityGovernor, textBodies, and headlessHost.' },
  { href: '/docs/cookbook', t: 'Cookbook — patterns by task', d: 'The depth layer beside this reference: signals-first and contained fields, bindData at scale, reading and instrumenting, conditions and formations, the workbench, performance tuning, chrome and accessibility, and framework interop — every pattern with an example that actually runs.' },
];
---

<DocsLayout
  title="Fundamental — API reference"
  description="The complete Fundamental API: createField & FieldOptions, the FieldHandle, every data-* attribute, all forces, presets, conditions, formations, render modes, and the core types. Generated from the engine's own catalog."
>
  <header class="docs-hero">
    <p class="kicker">API reference</p>
    <h1>The complete <span class="accent">surface</span>.</h1>
    <StatusChip label="Shipped · counts read from the engine catalog" tone="stable" />
    <p class="lede">
      Every option, method, attribute, and catalog entry. The forces, presets, conditions, and
      formations pages are generated from the engine's own catalog, so they can't drift from the
      code you install.
    </p>
  </header>

  <section class="docs-sec">
    <h2>Reference</h2>
    <div class="next-grid">
      {
        cards.map((c) => (
          <a class="next-card" href={c.href}>
            <b>{c.t}</b>
            <span>{c.d}</span>
          </a>
        ))
      }
    </div>
    <div class="callout">
      <b>At a glance.</b> {MANUAL_FORCES.length} forces · {MANUAL_PRESETS.length} presets ·
      {MANUAL_CONDITIONS.length} conditions · {FORMATIONS.length} formations ·
      {RENDER_MODES.length} render modes · {PALETTE_NAMES.length} palettes — one shared field
      runtime, host-native participation, a DOM adapter for the web, and a core with zero runtime dependencies.
    </div>
  </section>
</DocsLayout>
