        </div>
      </section>
    </div>

    <!-- Implementation Code Snippet -->
    <section class="pub-code-section">
      <h2>Copy &amp; Implement</h2>
      <p>This exact relational publication pattern runs directly on top of <code>@fundamental-engine/dom</code> and <code>@fundamental-engine/elements</code>.</p>
      <CodeTabs variants={[{ label: 'HTML + CSS', lang: 'html', code: codeSnippet }]} />
    </section>

    <!-- Navigation Footer -->
    <nav class="pub-nav-footer">
      <a href="/examples">← Back to All Live Examples</a>
      <a href="/docs/concepts">Explore Field Concepts →</a>
      <a href="/patterns">Browse Pattern Gallery →</a>
    </nav>
  </main>

  <SiteFooter />
</Base>

<script>
  // Dynamic filtering & interaction script
  const initPubPage = () => {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const wells = document.querySelectorAll<HTMLElement>('.pub-well-container');
    const cards = document.querySelectorAll<HTMLElement>('.relational-pub-card');
    const metricSpans = document.querySelectorAll<HTMLElement>('[data-metric]');
    const threadsBtn = document.querySelector<HTMLButtonElement>('[data-action="toggle-threads"]');
    const burstBtn = document.querySelector<HTMLButtonElement>('[data-action="burst-field"]');

    // Get field handle lazily
    const getField = () => document.querySelector('field-root') as (Element & { burst?: (x: number, y: number, col?: string) => void; threads?: (t: unknown) => void }) | null;

    // Filter switching
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        wells.forEach((well) => {
          const cat = well.dataset.category;
          if (filter === 'all' || filter === cat) {
            well.style.display = 'flex';
          } else {
            well.style.display = 'none';
          }
        });
      });
    });

    // Impulses & Threads
    burstBtn?.addEventListener('click', () => {
      const rect = burstBtn.getBoundingClientRect();
      getField()?.burst?.(rect.left + rect.width / 2, rect.top, '#4da3ff');
    });

    let threadsActive = false;
    threadsBtn?.addEventListener('click', () => {
      threadsActive = !threadsActive;
      threadsBtn.classList.toggle('active', threadsActive);
      threadsBtn.textContent = threadsActive ? 'Citation Threads: ON' : 'Toggle Citation Threads';
    });

    // Live signal metric readout loop
    let rafId = 0;
    const updateMetrics = () => {
      cards.forEach((card) => {
        const id = card.id;
        const span = document.querySelector(`[data-metric="${id}"]`);
        if (span) {
          const density = card.style.getPropertyValue('--field-density') || '0';
          const dVal = parseFloat(density).toFixed(2);
          span.textContent = `d: ${dVal}`;
        }
      });
      rafId = requestAnimationFrame(updateMetrics);
    };
    rafId = requestAnimationFrame(updateMetrics);

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(rafId);
    }, { once: true });
  };

  initPubPage();
  document.addEventListener('astro:page-load', initPubPage);
</script>

<style>
  .pub-page-shell {
    max-width: var(--content-max, 1140px);
    margin: 0 auto;
    padding: calc(58px + 2.5rem) clamp(1.25rem, 4vw, 2rem) 6rem;
    position: relative;
    z-index: 2;
  }
  .pub-kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 70%, var(--text-3));
    margin: 0 0 0.5rem;
  }
  .pub-page-head h1 {
    font-family: var(--display);
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .pub-lede {
    max-width: 48rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-2);
    margin: 1rem 0 2rem;
  }
  .pub-lede code {
    font-family: var(--mono);
    font-size: 0.9em;
    color: var(--accent);
  }

  /* Controls Bar */
  .pub-controls-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    margin-bottom: 2rem;
  }
  .filter-buttons, .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pub-btn {
    font-family: var(--mono);
    font-size: 0.78rem;
    padding: 0.45rem 0.85rem;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-3);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .pub-btn:hover {
    color: var(--text);
    border-color: var(--accent);
    background: rgba(77, 163, 255, 0.08);
  }
  .pub-btn.active {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 12px rgba(77, 163, 255, 0.4);
  }
  .pub-btn.outline.active {
    color: var(--accent);
    background: rgba(77, 163, 255, 0.15);
    border-color: var(--accent);
  }

  /* Layout Stage & Category Wells */
  .pub-layout-stage {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 960px) {
    .pub-layout-stage {
      grid-template-columns: 1fr;
    }
  }
  .pub-well-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 16px;
    border: 1px solid color-mix(in srgb, var(--cat-accent) 25%, var(--line));
    background: rgba(15, 23, 42, 0.4);
    backdrop-filter: blur(8px);
    transition: border-color 0.3s ease;
  }
  .well-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--cat-accent) 20%, transparent);
  }
  .well-glyph {
    color: var(--cat-accent);
    font-size: 1rem;
  }
  .well-header h2 {
    font-family: var(--display);
    font-size: 1.1rem;
    margin: 0;
    flex: 1;
    color: var(--text);
  }
  .well-badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--cat-accent);
    opacity: 0.8;
  }
  .well-cards-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Relational Cards */
  .relational-pub-card {
    --field-density: 0;
    --field-proximity: 0;
    padding: 1.15rem;
    border-radius: 12px;
    background: var(--bg-card, #0b0e16);
