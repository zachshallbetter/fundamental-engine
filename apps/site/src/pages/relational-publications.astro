            id="pub-3" 
            class="relational-pub-card" 
            data-body="attract" 
            data-strength="0.7" 
            data-range="240" 
            data-feedback 
            data-field-relation="cites" 
            data-field-target="#pub-1"
            data-category="research"
            style="--cat-accent: #4da3ff;"
            tabindex="0"
