        <div class="well-cards-list">
          <article 
            id="pub-1" 
            class="relational-pub-card" 
            data-body="attract" 
            data-strength="0.8" 
            data-range="260" 
            data-feedback 
            data-field-relation="cites" 
            data-field-target="#pub-2"
