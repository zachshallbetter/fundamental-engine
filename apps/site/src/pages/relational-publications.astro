    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-3);
    margin: 0 0 0.85rem;
  }
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    font-size: 0.7rem;
    padding-top: 0.5rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.08);
  }
  .citation-link {
    color: color-mix(in srgb, var(--cat-accent) 80%, var(--text-3));
  }
  .signal-metric {
    color: var(--text-4);
  }

  /* Code Section & Nav Footer */
  .pub-code-section {
    margin-top: 4rem;
  }
  .pub-code-section h2 {
    font-family: var(--display);
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }
