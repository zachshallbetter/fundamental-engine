    box-shadow: 0 4px 20px rgba(0, 0, 0, calc(0.2 + var(--field-density) * 0.4)),
                0 0 16px color-mix(in srgb, var(--cat-accent) calc(var(--field-density) * 55%), transparent);
    transform: scale(calc(1 + var(--field-density) * 0.03));
