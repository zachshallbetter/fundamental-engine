---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StatusChip from '../components/StatusChip.astro';
import CodeTabs from '../components/CodeTabs.astro';
import '../styles/docs.css';

const codeSnippet = `<field-root accent="#4da3ff" render="dots" overlay="links"></field-root>

<!-- Category Attractor Wells -->
<div class="category-wells-grid">
  <section class="category-well" data-body="well" data-strength="1.4" data-range="380" style="--cat-accent: #4da3ff;">
    <h2>Research Papers</h2>
    <article id="pub-1" class="pub-card" data-body="attract" data-strength="0.75" data-feedback data-field-relation="cites" data-field-target="#pub-2">
      <span class="pub-tag">Research</span>
      <h3>01. Relational Substrate Theory</h3>
      <p>Semantic structures, bodies, and field particles in one shared runtime.</p>
    </article>
  </section>

  <section class="category-well" data-body="well" data-strength="1.2" data-range="320" style="--cat-accent: #f59e0b;">
    <h2>Technical Specs</h2>
    <article id="pub-2" class="pub-card" data-body="attract" data-strength="0.6" data-feedback>
      <span class="pub-tag">Spec</span>
      <h3>02. Relationship Registry & Signals</h3>
      <p>Normalizing HTML, ARIA, and custom graph edges into runtime signals.</p>
    </article>
  </section>
</div>

<style>
  .pub-card {
    --field-density: 0;
    --field-proximity: 0;
    background: var(--bg-card, #0b0e16);
    border: 1px solid color-mix(in srgb, var(--cat-accent) calc(25% + var(--field-proximity) * 65%), var(--line));
    box-shadow: 0 4px 20px rgba(0, 0, 0, calc(0.2 + var(--field-density) * 0.4)),
                0 0 16px color-mix(in srgb, var(--cat-accent) calc(var(--field-proximity) * 60%), transparent);
    transform: scale(calc(1 + var(--field-proximity) * 0.035));
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
</style>`;
---

<Base
  title="Relational Publications — Fundamental Engine"
  description="Standalone interactive demonstration of relational publications, category attractor wells, citation graph edges, and signal-driven CSS formatting using Fundamental Engine."
>
  <SiteNav current="examples" />

  <main id="main" class="pub-page-shell">
