---
// The shared site footer — one consistent close on every public page: the
// wordmark + thesis line, the destinations, and contact.
import corePkg from '@fundamental-engine/core/package.json';
const version = corePkg.version; // single source of truth — never goes stale
const dest = [
  { href: '/docs', label: 'Docs' },
  { href: '/lab', label: 'Lab' },
  { href: 'mailto:hi@zachshallbetter.com', label: 'Contact' },
];
---

<footer class="site-foot">
  <div class="sf-inner">
    <div class="sf-brand">
      <span class="sf-name">Fundamental</span>
      <span class="sf-note">A relational field runtime for interfaces · v{version} · Created by <a href="https://zachshallbetter.com" target="_blank" rel="noopener noreferrer" class="sf-author">Zach Shallbetter</a></span>
    </div>
    <nav class="sf-links" aria-label="Footer">
      {dest.map((d) => <a href={d.href}>{d.label}</a>)}
    </nav>
    {/* Display / accessibility preferences — persisted per reader, restored before
        paint by the boot script in Base.astro. High contrast also follows the OS
        (prefers-contrast) until overridden here. */}
    <div class="sf-a11y">
      <span class="sf-a11y-label" id="sf-a11y-label">Display</span>
      <div class="sf-a11y-btns" role="group" aria-labelledby="sf-a11y-label">
        <button type="button" class="sf-a11y-btn" data-a11y="contrast" aria-pressed="false">
          High contrast
        </button>
        <button type="button" class="sf-a11y-btn" data-a11y="cvd" aria-pressed="false">
          Colorblind-safe
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  // A light Wayfinding Field over the footer destinations — same signals-only pattern as the top
  // nav: the engine writes --field-attention back onto each link (the current section pinned),
  // lazy-imported and reduced-motion-guarded so it costs nothing for plain/RM visitors.
  let footField: { destroy(): void } | null = null;
  let footGen = 0;
  const footReduce = () =>
    typeof matchMedia !== 'undefined' && matchMedia('(prefers-reduced-motion: reduce)').matches;

  async function startFootField() {
    const mine = ++footGen;
    footField?.destroy();
    footField = null;
    if (footReduce() || document.documentElement.dataset.field === 'off') return; // the one field switch
    const nav = document.querySelector<HTMLElement>('.sf-links');
    const links = nav ? [...nav.querySelectorAll<HTMLElement>('a[href^="/"]')] : [];
    if (!nav || !links.length) return;
    // pin the current section's footer link as the well
    const here = location.pathname.replace(/\/$/, '') || '/';
    for (const a of links) {
      const r = (a.getAttribute('href') || '').replace(/\/$/, '') || '/';
      if (r === here || (r !== '/' && here.startsWith(`${r}/`))) a.setAttribute('data-field-attention', '1');
    }
    try {
      const [{ patternById }, { applyPattern }] = await Promise.all([
        import('@fundamental-engine/core'),
        import('@fundamental-engine/dom'),
      ]);
      if (mine !== footGen) return;
      const base = patternById('wayfinding-field');
      if (!base) return;
      footField = applyPattern(nav, base, {
        renderless: true,
        bodies: links,
        annotateBodies: false,
      });
    } catch {
      /* the plain footer links stand on their own */
    }
  }
  function stopFootField() {
    footGen++;
    footField?.destroy();
    footField = null;
  }
  document.addEventListener('astro:page-load', startFootField);
  document.addEventListener('astro:before-swap', stopFootField);
  if (document.readyState !== 'loading') startFootField();
  else document.addEventListener('DOMContentLoaded', startFootField);
</script>

<script>
  // Display / accessibility preference toggles. Self-contained: they set
  // data-contrast / data-cvd on <html> and persist to localStorage; Base.astro's
  // head script restores them before paint. Contrast is tri-state (auto → high →
  // standard) so a reader can opt IN to high contrast or opt OUT of the OS
  // prefers-contrast default. CVD is a plain on/off (no OS media query exists).
  (() => {
    const root = document.documentElement;
    const osHighContrast = () =>
      typeof matchMedia !== 'undefined' && matchMedia('(prefers-contrast: more)').matches;
    const contrastOn = () => {
      const forced = root.dataset.contrast;
      return forced === 'high' || (!forced && osHighContrast());
    };
    const cvdOn = () => root.dataset.cvd === 'on';

    function sync() {
      document.querySelectorAll<HTMLButtonElement>('.sf-a11y-btn').forEach((btn) => {
        const on = btn.dataset.a11y === 'contrast' ? contrastOn() : cvdOn();
        btn.setAttribute('aria-pressed', String(on));
      });
    }
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('.sf-a11y-btn');
      if (!btn) return;
      if (btn.dataset.a11y === 'contrast') {
        const next = contrastOn() ? 'standard' : 'high';
        root.dataset.contrast = next;
        try {
          localStorage.setItem('fe:contrast', next);
        } catch {}
      } else {
        const next = !cvdOn();
        if (next) root.dataset.cvd = 'on';
        else delete root.dataset.cvd;
        try {
          if (next) localStorage.setItem('fe:cvd', 'on');
          else localStorage.removeItem('fe:cvd');
        } catch {}
      }
      sync();
    });
    document.addEventListener('astro:page-load', sync);
    sync();
  })();
</script>

<style>
  .site-foot {
    position: relative;
    z-index: 2;
    width: 100%;
    margin-top: auto;
    border-top: 1px solid var(--line, rgba(255, 255, 255, 0.1));
  }
  .sf-inner {
    max-width: 1360px;
    margin: 0 auto;
    padding: clamp(1.6rem, 4vh, 2.4rem) clamp(1.25rem, 3vw, 2.75rem);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 1.6rem;
  }
  .sf-brand {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .sf-name {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
    color: var(--text, #f3f6fc);
  }
  .sf-dim {
    color: var(--text-3, rgba(200, 212, 230, 0.46));
    font-weight: 600;
  }
  .sf-note {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3, rgba(200, 212, 230, 0.46));
  }
  .sf-author {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }
  .sf-author:hover {
    color: var(--accent, #4da3ff);
  }
  .sf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
  }
  .sf-links a {
    /* Wayfinding Field (signals-only): --field-attention eases ink + glow; unset → plain. */
    --att: var(--field-attention, 0);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(
      in srgb,
      var(--text, #f3f6fc) calc(var(--att) * 80%),
      var(--text-3, rgba(200, 212, 230, 0.46))
    );
    text-shadow: 0 0 calc(var(--att) * 8px)
      color-mix(in srgb, var(--accent, #4da3ff) calc(var(--att) * 50%), transparent);
    text-decoration: none;
    transition:
      color 0.2s ease,
      text-shadow 0.2s ease;
  }
  .sf-links a:hover {
    color: var(--accent, #4da3ff);
  }
  /* Display / accessibility preference toggles */
  .sf-a11y {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .sf-a11y-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3, rgba(200, 212, 230, 0.72));
  }
  .sf-a11y-btns {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .sf-a11y-btn {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-2, rgba(228, 235, 247, 0.78));
    background: transparent;
    border: 1px solid var(--line-2, rgba(255, 255, 255, 0.16));
    border-radius: var(--r-pill, 999px);
    padding: 0.3rem 0.7rem;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .sf-a11y-btn:hover {
    color: var(--text, #f3f6fc);
    border-color: var(--line-3, rgba(255, 255, 255, 0.24));
  }
  .sf-a11y-btn[aria-pressed='true'] {
    color: var(--bg-page, #04050a);
    background: var(--accent, #4da3ff);
    border-color: var(--accent, #4da3ff);
  }
  .sf-a11y-btn:focus-visible {
    outline: 2px solid var(--accent, #4da3ff);
    outline-offset: 2px;
  }
</style>
