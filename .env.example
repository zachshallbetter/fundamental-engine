# Example environment variables. Copy to .env.local (gitignored) and fill in.
# NEVER commit real secrets — .env.local and .env.* are gitignored.

# Publishing / CI (not needed to run the site locally)
NPM_TOKEN=""
GITHUB_TOKEN=""

# GA4 Measurement Protocol — consumed by the /api/collect edge function only.
# This is a server-side secret: it must NOT be exposed to the browser. In
# production, set GA_API_SECRET in Vercel → Project → Settings → Environment
# Variables. Without it, /api/collect is a silent no-op.
GA_API_SECRET=""
# Optional — defaults to the site's measurement id (G-M22BZ4PNB6) when unset.
GA_MEASUREMENT_ID=""
